// Запуск: /Execute ТестыОбменаWB.epf /C "Тесты;<обработка.epf>;<каталог wb-exchange>;<отчёт.txt>;<адрес мока>[;Объем]"
&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Части = СтрРазделить(ПараметрЗапуска, ";");
	Если Части.Количество() >= 5 И Части[0] = "Тесты" Тогда
		ВыполнитьНаСервере(Части[1], Части[2], Части[3], Части[4], Части.Количество() >= 6 И Части[5] = "Объем");
		ПодключитьОбработчикОжидания("Завершить", 0.1, Истина);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ВыполнитьНаСервере(ПутьКОбработке, Каталог, ПутьКОтчету, АдресМока, ПолныйОбъем)

	Попытка
		РеквизитФормыВЗначение("Объект").ВыполнитьВсе(ПутьКОбработке, Каталог, ПутьКОтчету, АдресМока, ПолныйОбъем);
	Исключение
		// Ошибка компиляции модуля тестов или обработки тоже должна попасть в отчёт, а не в окно.
		Текст = Новый ТекстовыйДокумент;
		Текст.УстановитьТекст("СБОЙ ЗАПУСКА ТЕСТОВ: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Текст.Записать(ПутьКОтчету, КодировкаТекста.UTF8);
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура Завершить() Экспорт

	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры
