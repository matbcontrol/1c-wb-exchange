// Тесты ждут на сервере пустым циклом. Форма обработки так не делает: она ждёт на клиенте.
Функция ПрогнатьОперацию(Операция, НастройкиОперации, Данные = Неопределено)

	Состояние = Обработка.НачатьОперацию(Операция, НастройкиОперации, Данные);
	Шагов = 0;
	Пока Не Состояние.Готово Цикл
		Обработка.ВыполнитьШаг(Состояние);
		Если Состояние.ЖдатьМс > 0 Тогда
			Подождать(Состояние.ЖдатьМс);
		КонецЕсли;
		Шагов = Шагов + 1;
		Если Шагов > 10000 Тогда
			ВызватьИсключение "Операция не завершилась за 10000 шагов";
		КонецЕсли;
	КонецЦикла;
	Возврат Состояние;

КонецФункции

Процедура Подождать(Миллисекунд)

	Конец = ТекущаяУниверсальнаяДатаВМиллисекундах() + Миллисекунд;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Конец Цикл
	КонецЦикла;

КонецПроцедуры

Функция КопияНастроек()

	Копия = Новый Структура;
	Для Каждого КлючИЗначение Из Настройки Цикл
		Копия.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Возврат Копия;

КонецФункции

#КонецОбласти

#Область Мок

Процедура РазобратьАдресМока(Адрес)

	Хост = СтрЗаменить(НРег(Адрес), "http://", "");
	Части = СтрРазделить(Хост, ":");
	МокХост = Части[0];
	МокПорт = ?(Части.Количество() > 1, Число(Части[1]), 80);

КонецПроцедуры

Функция Мок(Метод, Путь, Тело = Неопределено)

	Соединение = Новый HTTPСоединение(МокХост, МокПорт, , , , 10);
	Запрос = Новый HTTPЗапрос(Путь);
	Если Тело <> Неопределено Тогда
		Запрос.Заголовки.Вставить("Content-Type", "application/json");
		Запрос.УстановитьТелоИзСтроки(ВJSON(Тело), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;
	Ответ = Соединение.ВызватьHTTPМетод(Метод, Запрос);
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение "Мок ответил " + Ответ.КодСостояния + " на " + Путь;
	КонецЕсли;
	Возврат ИзJSON(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));

КонецФункции

Функция ЖурналМока(Очистить = Ложь)

	Лог = Мок("GET", "/__mock/log" + ?(Очистить, "?clear=1", ""));
	Возврат ?(ТипЗнч(Лог) = Тип("Массив"), Лог, Новый Массив);

КонецФункции

Функция ЧислоЗапросов(Лог, Метод, НачалоПути, КодОтвета)

	Количество = 0;
	Для Каждого Запись Из Лог Цикл
		Если (Метод = "" Или Запись.Получить("method") = Метод)
			И (НачалоПути = "" Или СтрНачинаетсяС(Запись.Получить("path"), НачалоПути))
			И (КодОтвета = 0 Или Запись.Получить("status") = КодОтвета) Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;

КонецФункции

Функция ТелаPUTБезSku(Лог)

	Для Каждого Запись Из Лог Цикл
		Если Запись.Получить("method") = "PUT" Тогда
			Тело = Запись.Получить("body");
			Если СтрНайти(Тело, """sku""") > 0 Или СтрНайти(Тело, """chrtId""") = 0 Тогда
				Возврат Тело;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция РасхожденияСкладаWB(Ряды)

	Склады = Мок("GET", "/__mock/stocks");
	Склад = Склады.Получить(Формат(Ожидается.settings.warehouseId, "ЧГ=0"));
	Расхождений = 0;
	Для Каждого Ряд Из Ряды Цикл
		Если Ряд.restricted Тогда
			Продолжить;
		КонецЕсли;
		// Нет записи на складе WB значит остаток 0.
		НаWB = Склад.Получить(Формат(Ряд.chrtId, "ЧГ=0"));
		Если ?(НаWB = Неопределено, 0, НаWB) <> Ряд.want Тогда
			Расхождений = Расхождений + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Расхождений;

КонецФункции

#КонецОбласти

#Область Данные

Функция РасхожденияОстатков(Таблица, Ряды, СравниватьWB)

	Расхождений = 0;
	Для Каждого Ряд Из Ряды Цикл
		Найдено = Таблица.НайтиСтроки(Новый Структура("chrtID", Ряд.chrtId));
		Если Найдено.Количество() <> 1 Тогда
			Расхождений = Расхождений + 1;
			Продолжить;
		КонецЕсли;
		Т = Найдено[0];
		Если Т.Свободно <> Ряд.free Или Т.КВыгрузке <> Ряд.want Или (СравниватьWB И Т.НаWB <> Ряд.onWb)
			Или Строка(Т.Номенклатура.УникальныйИдентификатор()) <> Ряд.uuid
			Или (ЗначениеЗаполнено(Ряд.charUuid) И Строка(Т.Характеристика.УникальныйИдентификатор()) <> Ряд.charUuid) Тогда
			Расхождений = Расхождений + 1;
			Если Расхождений <= 3 Тогда
				Строки.Добавить(СтрШаблон("        расхождение chrtId %1: свободно %2/%3, к выгрузке %4/%5, на WB %6/%7",
					Формат(Ряд.chrtId, "ЧГ=0"), Т.Свободно, Ряд.free, Т.КВыгрузке, Ряд.want, Т.НаWB, Ряд.onWb));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Расхождений;

КонецФункции

Функция ЗаказыWBВБазе()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Заказ.Ссылка) КАК Количество,
	|	ЕСТЬNULL(СУММА(Заказ.СуммаДокумента), 0) КАК Сумма
	|ИЗ
	|	Документ.ЗаказПокупателя КАК Заказ
	|ГДЕ
	|	Заказ.Контрагент = &Контрагент
	|	И НЕ Заказ.ПометкаУдаления");
	Запрос.УстановитьПараметр("Контрагент", Настройки.Контрагент);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Новый Структура("Количество, Сумма", Выборка.Количество, Выборка.Сумма);

КонецФункции

Функция СвободныйОстаток(Uuid)

	Товары = Новый Массив;
	Для Каждого Ид Из Uuid Цикл
		Товары.Добавить(Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Ид)));
	КонецЦикла;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Запасы.КоличествоОстаток), 0) КАК Свободно
	|ИЗ
	|	РегистрНакопления.Запасы.Остатки(
	|			,
	|			СтруктурнаяЕдиница = &Склад
	|				И ЗаказПокупателя = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|				И Номенклатура В (&Товары)) КАК Запасы");
	Запрос.УстановитьПараметр("Склад", Настройки.Склад);
	Запрос.УстановитьПараметр("Товары", Товары);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Свободно;

