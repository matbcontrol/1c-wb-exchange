// Автотесты обработки «Обмен с Wildberries» против мока API WB (tools/wb-mock.js).
//
// Запуск через tools/test.ps1: он поднимает мок, восстанавливает демобазу из эталона до и после
// прогона, поэтому тесты могут свободно создавать заказы и контрагентов.
// 1cv8.exe ENTERPRISE /F <база> /Execute ТестыОбменаWB.epf /C "Тесты;<обработка.epf>;<каталог wb-exchange>;<отчёт.txt>;<адрес мока>"
//
// Ожидаемые числа берутся из samples/gen/expected.json: их считает генератор данных мока
// по смыслу данных, независимо от кода обработки.

Перем Обработка;
Перем Строки;
Перем Пройдено;
Перем Провалено;
Перем ФайлОтчета;
Перем НачалоПрогона;
Перем НачалоРаздела;
Перем Ожидается;
Перем Настройки;
Перем МокХост;
Перем МокПорт;

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ВыполнитьВсе(ПутьКОбработке, Каталог, ПутьКОтчету, АдресМока, ПолныйОбъем = Ложь) Экспорт

	Строки = Новый Массив;
	Пройдено = 0;
	Провалено = 0;
	ФайлОтчета = ПутьКОтчету;
	НачалоПрогона = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Попытка
		Обработка = ВнешниеОбработки.Создать(ПутьКОбработке, Ложь);
		Ожидается = ПрочитатьОжидаемое(Каталог + "\samples\gen\expected.json");
		РазобратьАдресМока(АдресМока);

		Раздел("Правила остатков и отмен");
		ТестыПравил();

		Подготовить(АдресМока);

		Раздел("Склады продавца на WB");
		ТестСкладов();
		Раздел("Товар с характеристиками: размер WB только по штрихкоду");
		ТестХарактеристик();
		Раздел("Остатки до загрузки заказов");
		ОстаткиДо = ТестРасчетаОстатков();
		Раздел("Карточки по 10 на страницу: лимит WB не превышен");
		ТестПагинацииКарточек();
		Раздел("Выгрузка остатков пачками по 20 и сверка");
		ТестВыгрузки(ОстаткиДо);
		Раздел("Склад обновляется, потом WB отвечает 204 и не меняет остаток");
		ТестТихогоОтвета();

		Раздел("Новые задания WB");
		Заказы = ТестНовыхЗаданий();
		Раздел("Создание заказов в 1С");
		ТестСозданияЗаказов(Заказы);
		Раздел("Повторная загрузка тех же заданий");
		ТестПовторнойЗагрузки();
		Раздел("Резерв под заказы уменьшил свободный остаток");
		ТестОстатковПослеЗаказов();

		Раздел("Сбои WB: 500, 429, недоступность");
		ТестСбоев();
		Раздел("Ошибки токена");
		ТестТокенов();
		Раздел("Отмена на WB закрывает заказ и снимает резерв");
		ТестОтмен();
		Раздел("Задания за период, по 10 на страницу");
		ТестПериода();
		Раздел("Объём: 300 новых заданий");
		ТестОбъема(ПолныйОбъем);
		Раздел("Настройки и токен");
		ТестНастроек();
	Исключение
		Провалено = Провалено + 1;
		Строки.Добавить("СБОЙ ТЕСТОВ: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ЗакрытьРаздел();
	СохранитьОтчет(Истина);
	Возврат Провалено = 0;

КонецФункции

#Область Тесты

Процедура ТестыПравил()

	Н = Обработка.НовыеНастройки();
	Н.СтраховойЗапас = 1;
	Н.ПроцентОстатка = 100;
	Проверить("свободно 10, страховой запас 1 → 9", Обработка.ОстатокКВыгрузке(10, Н), 9);
	Проверить("дробный остаток 0,5 → 0", Обработка.ОстатокКВыгрузке(0.5, Н), 0);
	Проверить("отрицательный остаток → 0", Обработка.ОстатокКВыгрузке(-3, Н), 0);
	Проверить("200 000 → 100 000, лимит WB", Обработка.ОстатокКВыгрузке(200000, Н), 100000);
	Н.СтраховойЗапас = 0;
	Н.ПроцентОстатка = 50;
	Проверить("50 % от 7 → 3, округление вниз", Обработка.ОстатокКВыгрузке(7, Н), 3);

	Проверить("продавец отменил (cancel)", Обработка.ЗаданиеОтменено("cancel", "waiting"), Истина);
	Проверить("покупатель отказался при получении", Обработка.ЗаданиеОтменено("complete", "canceled_by_client"), Истина);
	Проверить("покупатель отменил в первый час", Обработка.ЗаданиеОтменено("new", "declined_by_client"), Истина);
	Проверить("отмена из-за брака", Обработка.ЗаданиеОтменено("complete", "defect"), Истина);
	Проверить("продано: не отмена", Обработка.ЗаданиеОтменено("complete", "sold"), Ложь);
	Проверить("на сборке: не отмена", Обработка.ЗаданиеОтменено("confirm", "sorted"), Ложь);

КонецПроцедуры

Процедура ТестСкладов()

	С = ПрогнатьОперацию("Склады", Настройки);
	Проверить("без ошибок", С.Ошибка, "");
	Проверить("складов продавца", С.Склады.Количество(), 2);
	ФБС = С.Склады.НайтиСтроки(Новый Структура("ТипДоставки", 1));
	Проверить("склад FBS", ?(ФБС.Количество() = 1, ФБС[0].Идентификатор, 0), Ожидается.settings.warehouseId);

КонецПроцедуры

// Перчатки в демобазе учитываются по характеристикам S, L, XL, на WB у карточки три размера.
// Пока штрихкодов WB на характеристиках нет, обработка не угадывает размер по артикулу, а подсказывает.
// Потом тест заводит штрихкоды, как это сделал бы продавец, и каждый размер находит свою характеристику.
Процедура ТестХарактеристик()

	Х = Ожидается.chars;
	С = ПрогнатьОперацию("Остатки", Настройки);
	Размеры = С.Остатки.НайтиСтроки(Новый Структура("АртикулПродавца", Х.vendorCode));
	Проверить("размеров у карточки перчаток", Размеры.Количество(), Х.rows.Количество());
	НеСопоставлено = 0;
	Для Каждого Т Из Размеры Цикл
		Если Т.Статус = "Не сопоставлен" И СтрНайти(Т.Пояснение, "характеристик") > 0 Тогда
			НеСопоставлено = НеСопоставлено + 1;
		КонецЕсли;
	КонецЦикла;
	Проверить("без штрихкодов WB размеры не угадываются, в строке подсказка", НеСопоставлено, Х.rows.Количество());
	Строки.Добавить("        " + ?(Размеры.Количество() > 0, Размеры[0].Пояснение, ""));

	С = ПрогнатьОперацию("Заказы", Настройки);
	Заказ = С.Заказы.Найти(Х.orderId, "ИдЗадания");
	ПроверитьИстина("заказ на размер без штрихкода не создаётся с пустой характеристикой",
		Заказ <> Неопределено И Заказ.Статус = "Неоднозначно" И СтрНайти(Заказ.Пояснение, "характеристик") > 0,
		?(Заказ = Неопределено, "нет строки", Заказ.Статус + ": " + Заказ.Пояснение));

	Товар = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Х.goodUuid));
	Для Каждого Ряд Из Х.rows Цикл
		Запись = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
		Запись.Штрихкод = Ряд.barcode;
		Запись.Номенклатура = Товар;
		Запись.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(Ряд.charUuid));
		Запись.Записать();
	КонецЦикла;

	С = ПрогнатьОперацию("Остатки", Настройки);
	Расхождений = 0;
	Для Каждого Ряд Из Х.rows Цикл
		Т = С.Остатки.Найти(Ряд.chrtId, "chrtID");
		Если Т = Неопределено Или Т.КакНайден <> "штрихкод" Или Строка(Т.Характеристика.УникальныйИдентификатор()) <> Ряд.charUuid
			Или Т.Свободно <> Ряд.free Или Т.КВыгрузке <> Ряд.want Тогда
			Расхождений = Расхождений + 1;
			Строки.Добавить(СтрШаблон("        размер %1: %2", Ряд.charName, ?(Т = Неопределено, "нет строки",
				Т.КакНайден + ", " + Т.Характеристика + ", свободно " + Т.Свободно + ", к выгрузке " + Т.КВыгрузке)));
		КонецЕсли;
	КонецЦикла;
	Проверить("со штрихкодами каждый размер нашёл свою характеристику и её остаток", Расхождений, 0);

	С = ПрогнатьОперацию("Заказы", Настройки);
	Заказ = С.Заказы.Найти(Х.orderId, "ИдЗадания");
	Проверить("заказ найден по штрихкоду вместе с характеристикой",
		?(Заказ = Неопределено, "", Заказ.Статус + ", " + Заказ.КакНайден + ", " + Заказ.Характеристика),
		Обработка.СтатусЗаказаНовый() + ", штрихкод, " + Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(Х.orderCharUuid)));

КонецПроцедуры

Функция ТестРасчетаОстатков()

	ЖурналМока(Истина);
	С = ПрогнатьОперацию("Остатки", Настройки);
	Проверить("без ошибок", С.Ошибка, "");
	Проверить("размеров в карточках WB", С.Остатки.Количество(), Ожидается.cards.sizes);
	Проверить("сопоставлено по артикулу", Сосчитать(С.Остатки, "КакНайден", "артикул"), Ожидается.cards.byArticle);
	Проверить("сопоставлено по штрихкоду", Сосчитать(С.Остатки, "КакНайден", "штрихкод"), Ожидается.cards.byBarcode);
	Проверить("не сопоставлено", Сосчитать(С.Остатки, "Статус", "Не сопоставлен"), Ожидается.cards.notMapped);
	Размеры = С.Остатки.НайтиСтроки(Новый Структура("АртикулПродавца", Ожидается.cards.multiSizeVendorCode));
	ПроверитьИстина("карточку с двумя размерами не раскладывает по артикулу",
		Размеры.Количество() = 2 И Размеры[0].Статус = "Не сопоставлен" И СтрНайти(Размеры[0].Пояснение, "размер") > 0,
		?(Размеры.Количество() > 0, Размеры[0].Пояснение, "нет строк"));
	Проверить("изменится", Сосчитать(С.Остатки, "Статус", "Изменится"), Ожидается.stocksBefore.changed);
	Проверить("без изменений", Сосчитать(С.Остатки, "Статус", "Без изменений"), Ожидается.stocksBefore.unchanged);
	Проверить("сумма к выгрузке", СуммаКолонки(С.Остатки, "КВыгрузке"), Ожидается.stocksBefore.totalWant);
	Проверить("построчно: свободно, к выгрузке и на WB совпадают с генератором", РасхожденияОстатков(С.Остатки, Ожидается.stocksBefore.rows, Истина), 0);
	Проверить("запросов к WB: страница карточек и чтение остатков", ЖурналМока().Количество(), 2);
	Возврат С.Остатки;

КонецФункции

Процедура ТестПагинацииКарточек()

	Мок("POST", "/__mock/limits", Новый Структура("enabled", Истина));
	ЖурналМока(Истина);
	Н = КопияНастроек();
	Н.СтраницаКарточек = 10;
	С = ПрогнатьОперацию("Остатки", Н);
	Мок("POST", "/__mock/limits", Новый Структура("enabled", Ложь));
	Проверить("без ошибок", С.Ошибка, "");
	Проверить("размеров столько же, сколько одной страницей", С.Остатки.Количество(), Ожидается.cards.sizes);
	Проверить("изменится столько же", Сосчитать(С.Остатки, "Статус", "Изменится"), Ожидается.stocksBefore.changed);
	Лог = ЖурналМока();
	// Последняя страница неполная или пустая: по ней обработка понимает, что карточки кончились.
	Проверить("страниц карточек по 10", ЧислоЗапросов(Лог, "POST", "/content/v2/get/cards/list", 200), Цел(Ожидается.cards.total / 10) + 1);
	Проверить("ответов 429: обработка держит интервал сама", ЧислоЗапросов(Лог, "", "", 429), 0);
	ПроверитьИстина("после всплеска из 5 запросов ждёт по 750 мс", С.ДлительностьМс >= 3 * 700, "заняло " + С.ДлительностьМс + " мс");

КонецПроцедуры

Процедура ТестВыгрузки(ОстаткиДо)

	Н = КопияНастроек();
	Н.РазмерПачки = 20;
	ЖурналМока(Истина);
	С = ПрогнатьОперацию("ВыгрузкаОстатков", Н, ОстаткиДо);
	Изменится = Ожидается.stocksBefore.changed;
	Запрещено = Ожидается.stocksBefore.restrictedChanged;
	Проверить("без ошибок", С.Ошибка, "");
	Проверить("выгружено и подтверждено сверкой", Сосчитать(С.Остатки, "Статус", "Выгружено"), Изменится - Запрещено);
	Проверить("отклонено WB (категорию нельзя по FBS)", Сосчитать(С.Остатки, "Статус", "Отклонено WB"), Запрещено);
	Отклонено = С.Остатки.НайтиСтроки(Новый Структура("Статус", "Отклонено WB"));
	ПроверитьИстина("причина отказа по-русски", Отклонено.Количество() > 0 И СтрНайти(Отклонено[0].Пояснение, "FBS") > 0,
		?(Отклонено.Количество() > 0, Отклонено[0].Пояснение, ""));
	Лог = ЖурналМока();
	Проверить("PUT пачками по 20", ЧислоЗапросов(Лог, "PUT", "/api/v3/stocks/", 0), Цел((Изменится + 19) / 20));
	Проверить("сверка пачками по 20", ЧислоЗапросов(Лог, "POST", "/api/v3/stocks/", 0), Цел((Изменится - Запрещено + 19) / 20));
	Проверить("остатки по chrtId, без устаревшего sku", ТелаPUTБезSku(Лог), "");
	Проверить("на складе WB теперь расчётные остатки", РасхожденияСкладаWB(Ожидается.stocksBefore.rows), 0);

	С2 = ПрогнатьОперацию("Остатки", Настройки);
	Проверить("при повторном расчёте меняться нечему, кроме запрещённой позиции", Сосчитать(С2.Остатки, "Статус", "Изменится"), Запрещено);

КонецПроцедуры

Процедура ТестТихогоОтвета()

	Н = КопияНастроек();
	Н.СтраховойЗапас = Н.СтраховойЗапас + 1;
	Н.РазмерПачки = 20;
	Предпросмотр = ПрогнатьОперацию("Остатки", Н);
	ОжидИзменений = 0;
	Для Каждого Ряд Из Ожидается.stocksBefore.rows Цикл
		Сейчас = ?(Ряд.restricted, Ряд.onWb, Ряд.want);
		Новый1 = Обработка.ОстатокКВыгрузке(Ряд.free, Н);
		Если Новый1 <> Сейчас Тогда
			ОжидИзменений = ОжидИзменений + 1;
		КонецЕсли;
	КонецЦикла;
	Проверить("при страховом запасе 2 изменится", Сосчитать(Предпросмотр.Остатки, "Статус", "Изменится"), ОжидИзменений);

	Сбой = Новый Структура("method, path, status, times", "PUT", "/api/v3/stocks", 409, 1);
	Сбой.Вставить("body", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Новый Структура("code, message", "StoreIsProcessing", "The store is processing")));
	Мок("POST", "/__mock/fault", Сбой);
	Мок("POST", "/__mock/fault", Новый Структура("method, path, mode, times", "PUT", "/api/v3/stocks", "silent204", 1));
	С = ПрогнатьОперацию("ВыгрузкаОстатков", Н, Предпросмотр.Остатки);
	Проверить("без ошибок", С.Ошибка, "");
	Проверить("повтор после «склад обновляется»", С.Повторов, 1);
	ПроверитьИстина("пауза 3 с перед повтором", С.ПаузМс >= 3000, "" + С.ПаузМс + " мс");
	НеПодтверждено = С.Остатки.НайтиСтроки(Новый Структура("Статус", "Не подтверждено"));
	Проверить("первая пачка не подтверждена: WB ответил 204, но остаток прежний", НеПодтверждено.Количество(), Мин(20, ОжидИзменений));
	ПроверитьИстина("в пояснении видно, что осталось на WB", НеПодтверждено.Количество() > 0 И СтрНайти(НеПодтверждено[0].Пояснение, "вместо") > 0,
		?(НеПодтверждено.Количество() > 0, НеПодтверждено[0].Пояснение, ""));
	Проверить("все изменения учтены: выгружено, не подтверждено, отклонено",
		Сосчитать(С.Остатки, "Статус", "Выгружено") + НеПодтверждено.Количество() + Сосчитать(С.Остатки, "Статус", "Отклонено WB"), ОжидИзменений);

КонецПроцедуры

Функция ТестНовыхЗаданий()

	ЖурналМока(Истина);
	С = ПрогнатьОперацию("Заказы", Настройки);
	О = Ожидается.orders;
	Проверить("без ошибок", С.Ошибка, "");
	Проверить("заданий", С.Заказы.Количество(), О.newTotal);
	Проверить("к созданию", Сосчитать(С.Заказы, "Статус", Обработка.СтатусЗаказаНовый()), О.created);
	Проверить("найдено по артикулу", Сосчитать(С.Заказы, "КакНайден", "артикул"), О.byArticle);
	Проверить("найдено по штрихкоду", Сосчитать(С.Заказы, "КакНайден", "штрихкод"), О.byBarcode);
	Проверить("товар не найден", Сосчитать(С.Заказы, "Статус", "Товар не найден"), О.notFound);
	НеНайден = С.Заказы.Найти(О.notFoundId, "ИдЗадания");
	ПроверитьИстина("в пояснении артикул WB", НеНайден <> Неопределено И СтрНайти(НеНайден.Пояснение, "UNKNOWN-777") > 0,
		?(НеНайден = Неопределено, "нет строки", НеНайден.Пояснение));
