// Форма обмена с Wildberries.
// Операция идёт шагами: сервер выполняет запросы к WB, пока не понадобится пауза,
// клиент ждёт через обработчик ожидания и вызывает следующий шаг.
//
// Запуск по расписанию:
//   1cv8.exe ENTERPRISE /F <база> /N <пользователь> /Execute ОбменWildberries.epf /C "ЗагрузитьЗаказы;C:\Обмен\wb_заказы.txt"
//   команды: ЗагрузитьЗаказы, ВыгрузитьОстатки, ОбновитьСтатусы; настройки и токен берутся сохранённые.
// Открыть форму и сразу выполнить операции по очереди, оставив форму открытой:
//   /C "Открыть;Заказы,СоздатьЗаказы,Статусы"  или  /C "Открыть;ОстаткиПолностью"

&НаКлиенте
Перем Цепочка; // операции из параметра «Открыть;...», ещё не выполненные

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Обработка = РеквизитФормыВЗначение("Объект");
	// Ошибка чтения настроек не должна останавливать открытие формы: при запуске по расписанию
	// окно с ошибкой некому закрыть.
	ОшибкаНастроек = "";
	Попытка
		НастройкиВФорму(Обработка.ЗагрузитьНастройки());
	Исключение
		ОшибкаНастроек = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		НастройкиВФорму(Обработка.НовыеНастройки());
	КонецПопытки;
	ПериодНачало = НачалоДня(ТекущаяДатаСеанса() - 7 * 86400);
	ПериодКонец = КонецДня(ТекущаяДатаСеанса());
	АдресСостояния = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	Элементы.Токен.РежимПароля = Истина;
	Элементы.СкладWB.КнопкаВыпадающегоСписка = Истина;
	НастроитьОформление();
	Если ЗначениеЗаполнено(ОшибкаНастроек) Тогда
		Прогресс = НСтр("ru = 'Не удалось прочитать сохранённые настройки, заполните их заново: '") + ОшибкаНастроек;
	Иначе
		Прогресс = НСтр("ru = 'Получите новые задания WB или рассчитайте остатки.'");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Если ПустаяСтрока(ПараметрЗапуска) Тогда
		Возврат;
	КонецЕсли;
	Части = СтрРазделить(ПараметрЗапуска, ";");
	// Работа начинается после открытия формы, чтобы окно успело показаться.
	Если Части[0] = "Открыть" И Части.Количество() > 1 Тогда
		Цепочка = СтрРазделить(Части[1], ",", Ложь);
		ПодключитьОбработчикОжидания("СледующаяВЦепочке", 0.1, Истина);
		Возврат;
	КонецЕсли;
	Операции = Новый Соответствие;
	Операции.Вставить("ЗагрузитьЗаказы", "Заказы");
	Операции.Вставить("ВыгрузитьОстатки", "ОстаткиПолностью");
	Операции.Вставить("ОбновитьСтатусы", "Статусы");
	Операция = Операции.Получить(Части[0]);
	Если Операция = Неопределено Тогда
		Возврат;
	КонецЕсли;
	РежимПакета = Истина;
	ПутьОтчета = ?(Части.Количество() > 1, Части[1], "");
	Цепочка = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Операция);
	ПодключитьОбработчикОжидания("СледующаяВЦепочке", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПолучитьЗаказы(Команда)
	ЗапуститьОперацию("Заказы");
КонецПроцедуры

&НаКлиенте
Процедура ЗаказыЗаПериод(Команда)
	ЗапуститьОперацию("ЗаказыЗаПериод");
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаказы(Команда)

	Если Не ЗначениеЗаполнено(ТекущаяОперация) Тогда
		СоздатьЗаказыНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусы(Команда)
	ЗапуститьОперацию("Статусы");
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьОстатки(Команда)
	ЗапуститьОперацию("Остатки");
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьОстатки(Команда)
	ЗапуститьОперацию("ВыгрузкаОстатков");
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСклады(Команда)
	ЗапуститьОперацию("Склады");
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройки(Команда)

	СохранитьНастройкиНаСервере();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Настройки сохранены'"), , НСтр("ru = 'Токен лежит в безопасном хранилище'"));

КонецПроцедуры

&НаКлиенте
Процедура НастройкаПриИзменении(Элемент)
	// Настройки берутся из реквизитов формы при каждом запуске операции.
КонецПроцедуры

#КонецОбласти

#Область ШагиОперации

&НаКлиенте
Процедура ЗапуститьОперацию(Операция)

	Если ЗначениеЗаполнено(ТекущаяОперация) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Дождитесь окончания текущей операции.'"));
		Возврат;
	КонецЕсли;
	ТекущаяОперация = Операция;
	ОбработатьШаг(НачатьОперациюНаСервере(Операция));

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьШаг(Результат)

	Прогресс = Результат.Прогресс;
	Если Не Результат.Готово Тогда
		ПодключитьОбработчикОжидания("ПродолжитьОперацию", Макс(0.1, Результат.ЖдатьМс / 1000), Истина);
		Возврат;
	КонецЕсли;
	Операция = ТекущаяОперация;
	ТекущаяОперация = "";
	Если РежимПакета Тогда
		ЗавершитьПакет(Операция, Результат);
	ИначеЕсли ЗначениеЗаполнено(Результат.Ошибка) Тогда
		Цепочка = Неопределено;
		ПоказатьПредупреждение(, Результат.Ошибка);
	Иначе
		СледующаяВЦепочке();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СледующаяВЦепочке() Экспорт

	Если ТипЗнч(Цепочка) <> Тип("Массив") Или Цепочка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Операция = СокрЛП(Цепочка[0]);
	Цепочка.Удалить(0);
	Если СтрНачинаетсяС(Операция, "Остатки") Или Операция = "ВыгрузкаОстатков" Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаОстатки;
	ИначеЕсли Операция = "Склады" Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНастройки;
	Иначе
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЗаказы;
	КонецЕсли;
	Если Операция = "СоздатьЗаказы" Тогда
		СоздатьЗаказыНаСервере();
		СледующаяВЦепочке();
	Иначе
		ЗапуститьОперацию(Операция);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОперацию() Экспорт
	ОбработатьШаг(ВыполнитьШагНаСервере());
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьПакет(Операция, Результат)

	Если Операция = "Заказы" И Не ЗначениеЗаполнено(Результат.Ошибка) Тогда
		СоздатьЗаказыНаСервере();
	КонецЕсли;
	ЗаписатьОтчетПакета(Операция, Результат.Ошибка);
	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры

&НаСервере
Функция НачатьОперациюНаСервере(Операция)

	Обработка = РеквизитФормыВЗначение("Объект");
	Данные = Неопределено;
	Если Операция = "ВыгрузкаОстатков" Тогда
		Данные = РеквизитФормыВЗначение("Остатки");
	ИначеЕсли Операция = "ЗаказыЗаПериод" Тогда
		Данные = Новый Структура("Начало, Конец", НачалоДня(ПериодНачало), КонецДня(ПериодКонец));
	КонецЕсли;
	Состояние = Обработка.НачатьОперацию(Операция, НастройкиИзФормы(), Данные);
	Возврат ШагНаСервере(Обработка, Состояние);

КонецФункции

&НаСервере
Функция ВыполнитьШагНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Возврат ШагНаСервере(Обработка, ПолучитьИзВременногоХранилища(АдресСостояния));

КонецФункции

&НаСервере
Функция ШагНаСервере(Обработка, Состояние)

	Обработка.ВыполнитьШаг(Состояние, 15000);
	ПоместитьВоВременноеХранилище(Состояние, АдресСостояния);
	Если Состояние.Готово Тогда
		ПоказатьРезультат(Обработка, Состояние);
	КонецЕсли;
	Возврат Новый Структура("Готово, ЖдатьМс, Прогресс, Ошибка", Состояние.Готово, Состояние.ЖдатьМс,
		Обработка.ПредставлениеПрогресса(Состояние), Состояние.Ошибка);

КонецФункции

&НаСервере
Процедура ПоказатьРезультат(Обработка, Состояние)

	Операция = Состояние.Операция;
	Если Операция = "Заказы" Или Операция = "ЗаказыЗаПериод" Тогда
		ЗначениеВРеквизитФормы(ПроблемыСверху(Состояние.Заказы,
			"Ошибка,Товар не найден,Неоднозначно,Другой склад WB,Новый,Создан,Уже загружен", "ИдЗадания"), "Заказы");
		СводкаЗаказов = Обработка.ИтогЗаказов(Состояние.Заказы);
	ИначеЕсли Операция = "Статусы" Тогда
		// Отменённые на WB наверху: с ними что-то произошло.
		Таблица = Состояние.Статусы.Скопировать();
		Таблица.Сортировать("Отменен Убыв, ИдЗадания");
		ЗначениеВРеквизитФормы(Таблица, "Статусы");
		СводкаЗаказов = Обработка.ИтогСтатусов(Состояние.Статусы);
	ИначеЕсли Операция = "Склады" Тогда
		Элементы.СкладWB.СписокВыбора.Очистить();
		Типы = Новый Соответствие;
		Типы.Вставить(1, "FBS");
		Типы.Вставить(2, "DBS");
		// Имя переменной не должно совпадать с реквизитом формы «Склад», иначе цикл затрёт склад 1С.
		Для Каждого СкладПродавца Из Состояние.Склады Цикл
			ТипСклада = Типы.Получить(СкладПродавца.ТипДоставки);
			Элементы.СкладWB.СписокВыбора.Добавить(СкладПродавца.Идентификатор, СтрШаблон("%1 (%2)", СкладПродавца.Наименование,
				?(ТипСклада = Неопределено, СкладПродавца.ТипДоставки, ТипСклада)));
		КонецЦикла;
		ФБС = Состояние.Склады.НайтиСтроки(Новый Структура("ТипДоставки", 1));
		Если СкладWB = 0 И ФБС.Количество() = 1 Тогда
			СкладWB = ФБС[0].Идентификатор;
		КонецЕсли;
	ИначеЕсли Не ЗначениеЗаполнено(Состояние.Ошибка) Или Состояние.Остатки.Количество() > 0 Тогда
		ЗначениеВРеквизитФормы(ПроблемыСверху(Состояние.Остатки,
			"Отклонено WB,Не подтверждено,Не сопоставлен,Изменится,Выгружено,Без изменений", "АртикулПродавца, chrtID"), "Остатки");
		СводкаОстатков = Обработка.ИтогОстатков(Состояние.Остатки);
	КонецЕсли;

КонецПроцедуры

// Строки, с которыми надо что-то сделать, показываются первыми.
&НаСервереБезКонтекста
Функция ПроблемыСверху(Таблица, ПорядокСтатусов, Затем)

	Порядок = СтрРазделить(ПорядокСтатусов, ",");
	Копия = Таблица.Скопировать();
	Копия.Колонки.Добавить("ПорядокСтатуса", Новый ОписаниеТипов("Число"));
	Для Каждого СтрокаТаблицы Из Копия Цикл
		Индекс = Порядок.Найти(СтрокаТаблицы.Статус);
		СтрокаТаблицы.ПорядокСтатуса = ?(Индекс = Неопределено, Порядок.Количество(), Индекс);
	КонецЦикла;
	Копия.Сортировать("ПорядокСтатуса, " + Затем);
	Копия.Колонки.Удалить("ПорядокСтатуса");
	Возврат Копия;

КонецФункции

&НаСервере
Процедура СоздатьЗаказыНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Таблица = РеквизитФормыВЗначение("Заказы");
	Попытка
		Итог = Обработка.СоздатьЗаказы(Таблица, НастройкиИзФормы());
	Исключение
		ОбщегоНазначения.СообщитьПользователю(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	ЗначениеВРеквизитФормы(Таблица, "Заказы");
	СводкаЗаказов = Обработка.ИтогЗаказов(Таблица);
	Прогресс = СтрШаблон(НСтр("ru = 'Создано заказов: %1, уже были: %2, ошибок: %3.'"), Итог.Создано, Итог.Пропущено, Итог.Ошибок);

КонецПроцедуры

&НаСервере
Процедура ЗаписатьОтчетПакета(Операция, Ошибка)

	Если ПустаяСтрока(ПутьОтчета) Тогда
		Возврат;
	КонецЕсли;
	Текст = Новый ТекстовыйДокумент;
	Текст.ДобавитьСтроку(СтрШаблон("Обмен с Wildberries, %1, %2", Операция, Формат(ТекущаяДатаСеанса(), "ДЛФ=DT")));
	Если ЗначениеЗаполнено(Ошибка) Тогда
		Текст.ДобавитьСтроку("ОШИБКА: " + Ошибка);
	КонецЕсли;
	Если Операция = "Заказы" Или Операция = "Статусы" Тогда
		Текст.ДобавитьСтроку(СводкаЗаказов);
		Для Каждого Строка Из Заказы Цикл
			Если Строка.Статус <> "Создан" И Строка.Статус <> "Уже загружен" Тогда
				Текст.ДобавитьСтроку(СтрШаблон("  %1  %2  %3  %4", Формат(Строка.ИдЗадания, "ЧГ=0"), Строка.Статус, Строка.Артикул, Строка.Пояснение));
			КонецЕсли;
		КонецЦикла;
		Для Каждого Строка Из Статусы Цикл
			Если Строка.Отменен Тогда
				Текст.ДобавитьСтроку(СтрШаблон("  %1  %2  %3", Формат(Строка.ИдЗадания, "ЧГ=0"), Строка.Заказ1С, Строка.Действие));
			КонецЕсли;
		КонецЦикла;
	Иначе
		Текст.ДобавитьСтроку(СводкаОстатков);
		Для Каждого Строка Из Остатки Цикл
			Если Строка.Статус = "Отклонено WB" Или Строка.Статус = "Не подтверждено" Или Строка.Статус = "Не сопоставлен" Тогда
				Текст.ДобавитьСтроку(СтрШаблон("  %1  %2  %3  %4", Формат(Строка.chrtID, "ЧГ=0"), Строка.АртикулПродавца, Строка.Статус, Строка.Пояснение));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Текст.ДобавитьСтроку(Прогресс);
	Текст.Записать(ПутьОтчета, КодировкаТекста.UTF8);

КонецПроцедуры

#КонецОбласти

#Область Настройки

&НаСервере
Функция НастройкиИзФормы()

	Обработка = РеквизитФормыВЗначение("Объект");
	Настройки = Обработка.НовыеНастройки();
	Для Каждого КлючИЗначение Из Обработка.НовыеНастройки() Цикл
		Если Элементы.Найти(КлючИЗначение.Ключ) <> Неопределено Или КлючИЗначение.Ключ = "Токен" Тогда
			Настройки[КлючИЗначение.Ключ] = ЭтотОбъект[КлючИЗначение.Ключ];
		КонецЕсли;
	КонецЦикла;
	Возврат Настройки;

КонецФункции

&НаСервере
Процедура НастройкиВФорму(Настройки)

	Для Каждого КлючИЗначение Из Настройки Цикл
		Если Элементы.Найти(КлючИЗначение.Ключ) <> Неопределено Тогда
			ЭтотОбъект[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Обработка.СохранитьНастройки(НастройкиИзФормы());

КонецПроцедуры

#КонецОбласти

#Область Оформление

&НаСервере
Процедура НастроитьОформление()

	Красный = Новый Цвет(200, 30, 30);
	Оранжевый = Новый Цвет(196, 98, 0);
	Зеленый = Новый Цвет(26, 127, 55);
