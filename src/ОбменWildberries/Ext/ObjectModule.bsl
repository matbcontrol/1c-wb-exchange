Функция ИнтервалМс(Сервис)

	// Интервалы из таблиц лимитов: Маркетплейс 200 мс, Контент 750 мс.
	Возврат ?(Сервис = "content", 750, 200);

КонецФункции

#КонецОбласти

#Область HTTP

Функция ВыполнитьЗапрос(Настройки, Сервис, Метод, Путь, Тело)

	Ответ = Новый Структура("Код, Текст, Данные, Заголовки, Ошибка, Осталось, ВремяМс", 0, "", Неопределено, Новый Соответствие, "", -1, 0);
	Адрес = РазобратьАдрес(?(Сервис = "content", Настройки.АдресКонтент, Настройки.АдресМаркетплейс));
	Старт = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		ЗащищенноеСоединение = Неопределено;
		Если Адрес.Защищенное Тогда
			ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(, Новый СертификатыУдостоверяющихЦентровОС);
		КонецЕсли;
		Прокси = Неопределено;
		Если Не Адрес.Локальный Тогда
			Прокси = ПолучениеФайловИзИнтернета.ПолучитьПрокси(?(Адрес.Защищенное, "https", "http"));
		КонецЕсли;
		Соединение = Новый HTTPСоединение(Адрес.Хост, Адрес.Порт, , , Прокси, Настройки.ТаймаутСекунд, ЗащищенноеСоединение);
		HTTPЗапрос = Новый HTTPЗапрос(Адрес.Префикс + Путь);
		HTTPЗапрос.Заголовки.Вставить("Authorization", СокрЛП(Настройки.Токен));
		HTTPЗапрос.Заголовки.Вставить("Accept", "application/json");
		Если Тело <> Неопределено И Тело <> "" Тогда
			HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json");
			HTTPЗапрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		КонецЕсли;
		HTTPОтвет = Соединение.ВызватьHTTPМетод(Метод, HTTPЗапрос);
		Ответ.Код = HTTPОтвет.КодСостояния;
		Ответ.Текст = HTTPОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		Для Каждого Заголовок Из HTTPОтвет.Заголовки Цикл
			Ответ.Заголовки.Вставить(НРег(Заголовок.Ключ), Заголовок.Значение);
		КонецЦикла;
		Осталось = Ответ.Заголовки.Получить("x-ratelimit-remaining");
		Если Осталось <> Неопределено Тогда
			Ответ.Осталось = ЧислоИзСтроки(Осталось);
		КонецЕсли;
		Ответ.Данные = ИзJSON(Ответ.Текст);
	Исключение
		Ответ.Код = 0;
		Ответ.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Ответ.ВремяМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - Старт;
	Возврат Ответ;

КонецФункции

Функция РазобратьАдрес(Знач Адрес)

	Результат = Новый Структура("Хост, Порт, Защищенное, Префикс, Локальный", "", 443, Истина, "", Ложь);
	Адрес = СокрЛП(Адрес);
	Если СтрНачинаетсяС(НРег(Адрес), "http://") Тогда
		Результат.Защищенное = Ложь;
		Результат.Порт = 80;
		Адрес = Сред(Адрес, 8);
	ИначеЕсли СтрНачинаетсяС(НРег(Адрес), "https://") Тогда
		Адрес = Сред(Адрес, 9);
	КонецЕсли;
	Позиция = СтрНайти(Адрес, "/");
	Если Позиция > 0 Тогда
		Результат.Префикс = Сред(Адрес, Позиция);
		Адрес = Лев(Адрес, Позиция - 1);
	КонецЕсли;
	Если СтрЗаканчиваетсяНа(Результат.Префикс, "/") Тогда
		Результат.Префикс = Лев(Результат.Префикс, СтрДлина(Результат.Префикс) - 1);
	КонецЕсли;
	Позиция = СтрНайти(Адрес, ":");
	Если Позиция > 0 Тогда
		Результат.Порт = Число(Сред(Адрес, Позиция + 1));
		Адрес = Лев(Адрес, Позиция - 1);
	КонецЕсли;
	Результат.Хост = Адрес;
	Результат.Локальный = (Адрес = "localhost" Или Адрес = "127.0.0.1");
	Возврат Результат;

КонецФункции

Процедура ДобавитьЗапрос(Состояние, Сервис, Метод, Путь, Тело = "", Обработчик = "", Параметр = Неопределено)

	Элемент = Состояние.Очередь.Добавить();
	Элемент.Сервис = Сервис;
	Элемент.Метод = Метод;
	Элемент.Путь = Путь;
	Элемент.Тело = Тело;
	Элемент.Обработчик = Обработчик;
	Элемент.Параметр = Параметр;
	Элемент.Попыток = 0;
	Элемент.НеРаньше = 0;

КонецПроцедуры

Функция ТелоСтраницыКарточек(Лимит, Курсор)

	КурсорЗапроса = Новый Структура("limit", Лимит);
	Если Курсор <> Неопределено Тогда
		КурсорЗапроса.Вставить("updatedAt", Поле(Курсор, "updatedAt", ""));
		КурсорЗапроса.Вставить("nmID", Число(Поле(Курсор, "nmID", 0)));
	КонецЕсли;
	НастройкиЗапроса = Новый Структура;
	НастройкиЗапроса.Вставить("sort", Новый Структура("ascending", Истина));
	НастройкиЗапроса.Вставить("cursor", КурсорЗапроса);
	НастройкиЗапроса.Вставить("filter", Новый Структура("withPhoto", -1));
	Возврат Новый Структура("settings", НастройкиЗапроса);

