Функция ИтогОстатков(Остатки) Экспорт

	Части = СчетчикиПоКолонке(Остатки, "Статус");
	Части.Вставить(0, СтрШаблон(НСтр("ru = 'Размеров на WB: %1'"), Остатки.Количество()));
