// Обмен 1С:УНФ 3.0 с Wildberries по модели FBS (склад продавца):
//   - новые сборочные задания WB становятся «Заказами покупателей» с резервом товара;
//   - заказы, отменённые на WB, закрываются в 1С, резерв снимается;
//   - свободные остатки склада выгружаются на склад продавца WB, после выгрузки сверяются.
// Методы и форматы API сверены с документацией dev.wildberries.ru (ноябрь 2026):
// остатки передаются по chrtId (ID размера), sku для остатков WB отключил 20.05.2026.
//
// Запросы к WB выполняются через очередь. Если WB просит подождать (429, 5xx, склад обновляется),
// шаг возвращает ЖдатьМс, а ждёт вызывающий код: форма через обработчик ожидания. Платформа
// не разрешает ВызватьПаузу в клиент-серверном вызове, а пустой цикл занимал бы сервер.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Сведения для подключения через «Дополнительные отчеты и обработки» (БСП).
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.1.10.1");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = "1.0";
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	ПараметрыРегистрации.Информация = НСтр("ru = 'Обмен с Wildberries (FBS): заказы, остатки, отмены.'");

	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = НСтр("ru = 'Обмен с Wildberries'");
	Команда.Идентификатор = "ОткрытьФорму";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	Команда.ПоказыватьОповещение = Ложь;

	Возврат ПараметрыРегистрации;

КонецФункции

// Настройки обмена со значениями по умолчанию.
Функция НовыеНастройки() Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("Токен", "");
	Настройки.Вставить("АдресМаркетплейс", "https://marketplace-api.wildberries.ru");
	Настройки.Вставить("АдресКонтент", "https://content-api.wildberries.ru");
	Настройки.Вставить("СкладWB", 0);
	Настройки.Вставить("Склад", Справочники.СтруктурныеЕдиницы.ПустаяСсылка());
	Настройки.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	Настройки.Вставить("Контрагент", Справочники.Контрагенты.ПустаяСсылка());
	Настройки.Вставить("Договор", Справочники.ДоговорыКонтрагентов.ПустаяСсылка());
	Настройки.Вставить("СостояниеЗаказа", Справочники.СостоянияЗаказовПокупателей.ПустаяСсылка());
	Настройки.Вставить("Резервировать", Истина);
	Настройки.Вставить("СтраховойЗапас", 0);
	Настройки.Вставить("ПроцентОстатка", 100);
	Настройки.Вставить("ЗакрыватьОтмененные", Истина);
	Настройки.Вставить("РазмерПачки", 1000);
	Настройки.Вставить("СтраницаКарточек", 100);
	Настройки.Вставить("СтраницаЗаказов", 1000);
	Настройки.Вставить("ДнейСтатусов", 30);
	Настройки.Вставить("ТаймаутСекунд", 30);
	Настройки.Вставить("МаксПопыток", 6);
	Возврат Настройки;

КонецФункции

// Читает сохранённые настройки текущего пользователя и токен из безопасного хранилища.
Функция ЗагрузитьНастройки() Экспорт

	Настройки = НовыеНастройки();
	Сохраненные = ХранилищеОбщихНастроек.Загрузить(КлючНастроек(), "Настройки");
	Если ТипЗнч(Сохраненные) = Тип("Структура") Тогда
		// Только известные ключи: настройки от старой версии обработки не должны ломать загрузку.
		Для Каждого КлючИЗначение Из Сохраненные Цикл
			Если КлючИЗначение.Ключ <> "Токен" И Настройки.Свойство(КлючИЗначение.Ключ) Тогда
				Настройки.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Токен = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(КлючНастроек(), "Токен");
	УстановитьПривилегированныйРежим(Ложь);
	Если ТипЗнч(Токен) = Тип("Строка") Тогда
		Настройки.Токен = Токен;
	КонецЕсли;
	Возврат Настройки;

КонецФункции

// Сохраняет настройки. Токен кладётся в безопасное хранилище БСП, в настройки он не попадает.
Процедура СохранитьНастройки(Настройки) Экспорт

	Копия = Новый Структура;
	Для Каждого КлючИЗначение Из Настройки Цикл
		Если КлючИЗначение.Ключ <> "Токен" Тогда
			Копия.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	ХранилищеОбщихНастроек.Сохранить(КлючНастроек(), "Настройки", Копия);

	УстановитьПривилегированныйРежим(Истина);
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(КлючНастроек(), СокрЛП(Настройки.Токен), "Токен");
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Начинает операцию обмена. Дальше вызывайте ВыполнитьШаг, пока Состояние.Готово = Ложь;
// если ЖдатьМс > 0, перед следующим шагом подождите столько миллисекунд.
//
// Операции:
//   "Склады"            - склады продавца на WB;
//   "Заказы"            - новые сборочные задания, сопоставление с товарами 1С;
//   "ЗаказыЗаПериод"    - задания за период (Данные: Структура с полями Начало, Конец);
//   "Статусы"           - статусы загруженных заданий, закрытие отменённых;
//   "Остатки"           - карточки WB, расчёт остатков, сравнение с тем, что стоит на WB;
//   "ВыгрузкаОстатков"  - отправка изменённых остатков (Данные: таблица из операции "Остатки") и сверка;
//   "ОстаткиПолностью"  - расчёт, выгрузка и сверка за один проход (для запуска по расписанию).
Функция НачатьОперацию(Операция, Настройки, Данные = Неопределено) Экспорт

	Состояние = Новый Структура;
	Состояние.Вставить("Операция", Операция);
	Состояние.Вставить("Настройки", Настройки);
	Состояние.Вставить("Фазы", ПланФаз(Операция));
	Состояние.Вставить("ИндексФазы", 0);
	Состояние.Вставить("Фаза", "");
	Состояние.Вставить("Очередь", НоваяОчередь());
	Состояние.Вставить("Готово", Ложь);
	Состояние.Вставить("ЖдатьМс", 0);
	Состояние.Вставить("Ошибка", "");
	Состояние.Вставить("Запросов", 0);
	Состояние.Вставить("Повторов", 0);
	Состояние.Вставить("ПаузМс", 0);
	Состояние.Вставить("Начало", ТекущаяУниверсальнаяДатаВМиллисекундах());
	Состояние.Вставить("ДлительностьМс", 0);
	Состояние.Вставить("Сообщения", Новый Массив);
	Состояние.Вставить("Период", Неопределено);
	Состояние.Вставить("Склады", НоваяТаблицаСкладов());
	Состояние.Вставить("Карточки", НоваяТаблицаРазмеров());
	Состояние.Вставить("Заказы", НоваяТаблицаЗаказов());
	Состояние.Вставить("Остатки", НоваяТаблицаОстатков());
	Состояние.Вставить("Статусы", НоваяТаблицаСтатусов());

	Если Состояние.Фазы.Количество() = 0 Тогда
		Остановить(Состояние, СтрШаблон(НСтр("ru = 'Неизвестная операция: %1'"), Операция));
		Возврат Состояние;
	КонецЕсли;

	Ошибки = ПроверитьНастройки(Настройки, Операция);
	Если Ошибки.Количество() > 0 Тогда
		Остановить(Состояние, СтрСоединить(Ошибки, Символы.ПС));
		Возврат Состояние;
	КонецЕсли;

	Если Операция = "ВыгрузкаОстатков" Тогда
		Если ТипЗнч(Данные) <> Тип("ТаблицаЗначений") Тогда
			Остановить(Состояние, НСтр("ru = 'Сначала рассчитайте остатки.'"));
			Возврат Состояние;
		КонецЕсли;
		Состояние.Остатки = ТаблицаПоОбразцу(Данные, НоваяТаблицаОстатков());
	ИначеЕсли Операция = "ЗаказыЗаПериод" Тогда
		Если ТипЗнч(Данные) <> Тип("Структура") Или Не Данные.Свойство("Начало") Или Не Данные.Свойство("Конец")
			Или Данные.Конец < Данные.Начало Тогда
			Остановить(Состояние, НСтр("ru = 'Укажите период загрузки заданий.'"));
			Возврат Состояние;
		КонецЕсли;
		Состояние.Период = Данные;
	КонецЕсли;

	Возврат Состояние;

КонецФункции

// Выполняет запросы очереди и работу фаз, пока не закончится операция, не понадобится пауза
// или не выйдет время шага. Возвращает то же Состояние.
Функция ВыполнитьШаг(Состояние, БюджетМс = 20000) Экспорт

	Старт = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Состояние.ЖдатьМс = 0;

	Пока Не Состояние.Готово Цикл

		Если Состояние.Очередь.Количество() = 0 Тогда
			Если Состояние.ИндексФазы >= Состояние.Фазы.Количество() Тогда
				ЗавершитьОперацию(Состояние);
				Прервать;
			КонецЕсли;
			Состояние.Фаза = Состояние.Фазы[Состояние.ИндексФазы];
			Состояние.ИндексФазы = Состояние.ИндексФазы + 1;
			Попытка
				ВыполнитьФазу(Состояние, Состояние.Фаза);
			Исключение
				Остановить(Состояние, СтрШаблон(НСтр("ru = 'Ошибка на этапе «%1»: %2'"), ПредставлениеФазы(Состояние.Фаза),
					ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
				ЗаписьЖурналаРегистрации(СобытиеЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
					ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
			Продолжить;
		КонецЕсли;

		Элемент = Состояние.Очередь[0];
		Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Если Элемент.НеРаньше > Сейчас Тогда
			Состояние.ЖдатьМс = Элемент.НеРаньше - Сейчас;
			Прервать;
		КонецЕсли;

		Ответ = ВыполнитьЗапрос(Состояние.Настройки, Элемент.Сервис, Элемент.Метод, Элемент.Путь, Элемент.Тело);
		Состояние.Запросов = Состояние.Запросов + 1;
		Решение = ОценитьОтвет(Ответ, Элемент);

		Если Решение.Действие = "Повторить" Тогда
			Элемент.Попыток = Элемент.Попыток + 1;
			Если Элемент.Попыток >= Состояние.Настройки.МаксПопыток Тогда
				Остановить(Состояние, СтрШаблон(НСтр("ru = 'WB не ответил после %1 попыток. Последняя причина: %2'"),
					Элемент.Попыток, Решение.Текст));
				Прервать;
			КонецЕсли;
			Элемент.НеРаньше = ТекущаяУниверсальнаяДатаВМиллисекундах() + Решение.ПаузаМс;
			Состояние.Повторов = Состояние.Повторов + 1;
			Состояние.ПаузМс = Состояние.ПаузМс + Решение.ПаузаМс;
			Состояние.ЖдатьМс = Решение.ПаузаМс;
			ДобавитьСообщение(Состояние, Решение.Текст);
			Прервать;
		ИначеЕсли Решение.Действие = "Остановить" Тогда
			Остановить(Состояние, Решение.Текст);
			Прервать;
		КонецЕсли;

		Попытка
			ОбработатьОтвет(Состояние, Элемент, Ответ);
		Исключение
			Остановить(Состояние, СтрШаблон(НСтр("ru = 'Не удалось разобрать ответ WB на %1 %2: %3'"), Элемент.Метод, Элемент.Путь,
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			Прервать;
		КонецПопытки;
		Состояние.Очередь.Удалить(Элемент);

		// WB сообщает, сколько запросов осталось во всплеске. Если ноль, следующий запрос
		// отправляем не раньше интервала из документации, чтобы не получить 429.
		Если Ответ.Осталось = 0 И Состояние.Очередь.Количество() > 0 Тогда
			Следующий = Состояние.Очередь[0];
			Следующий.НеРаньше = Макс(Следующий.НеРаньше, ТекущаяУниверсальнаяДатаВМиллисекундах() + ИнтервалМс(Следующий.Сервис));
		КонецЕсли;

		Если ТекущаяУниверсальнаяДатаВМиллисекундах() - Старт > БюджетМс Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Состояние.ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - Состояние.Начало;
	Возврат Состояние;

КонецФункции

// Создаёт «Заказы покупателей» по строкам со статусом «Новый» и отметкой «Применить».
// Каждый заказ пишется в своей транзакции: ошибка в одном задании не мешает остальным.
// Перед записью ещё раз проверяется, что задание не загружено, поэтому повторный запуск безопасен.
Функция СоздатьЗаказы(Заказы, Настройки) Экспорт

	Итог = Новый Структура("Создано, Пропущено, Ошибок, ВремяМс", 0, 0, 0, 0);
	Старт = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Ошибки = ПроверитьНастройки(Настройки, "СозданиеЗаказов");
	Если Ошибки.Количество() > 0 Тогда
		ВызватьИсключение СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;

	Строки = Заказы.НайтиСтроки(Новый Структура("Статус, Применить", СтатусЗаказаНовый(), Истина));
	Если Строки.Количество() = 0 Тогда
		Возврат Итог;
	КонецЕсли;

	// Единицы измерения одним запросом, без обращения через точку в цикле.
	Товары = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		Товары.Добавить(Строка.Номенклатура);
	КонецЦикла;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В (&Товары)");
	Запрос.УстановитьПараметр("Товары", Товары);
	Единицы = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Единицы.Вставить(Выборка.Ссылка, Выборка.ЕдиницаИзмерения);
	КонецЦикла;

	НастройкиНДС = НалогиУНФ.НастройкиНДСОрганизации(Настройки.Организация, , ТекущаяДатаСеанса());

	// Если свободного остатка нет, заказ создаётся без резерва и с пометкой. С резервом УНФ его
	// не проведёт, а задание WB всё равно надо собрать или отменить в срок.
	Свободные = ТаблицаСвободныхОстатков(Товары, Настройки.Склад);

	Для Каждого Строка Из Строки Цикл
		Резерв = 0;
		Найдено = Свободные.НайтиСтроки(Новый Структура("Номенклатура, Характеристика", Строка.Номенклатура, Строка.Характеристика));
		Если Настройки.Резервировать И Найдено.Количество() > 0 И Найдено[0].Свободно >= 1 Тогда
			Резерв = 1;
		КонецЕсли;
		НачатьТранзакцию();
		Попытка
			Найденные = НайтиЗагруженныеЗаказы(Настройки.Контрагент, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Строка.ИдЗадания));
			Если Найденные.Количество() > 0 Тогда
				ОтменитьТранзакцию();
				Строка.Статус = СтатусЗаказаУжеЗагружен();
				Строка.Заказ1С = Найденные[0].Заказ;
				Строка.Применить = Ложь;
				Итог.Пропущено = Итог.Пропущено + 1;
				Продолжить;
			КонецЕсли;
			Документ = НовыйЗаказПокупателя(Строка, Настройки, Единицы.Получить(Строка.Номенклатура), НастройкиНДС, Резерв);
			ЗафиксироватьТранзакцию();
			Если Резерв > 0 Тогда
				Найдено[0].Свободно = Найдено[0].Свободно - Резерв;
			КонецЕсли;
			Строка.Статус = "Создан";
			Строка.Заказ1С = Документ.Ссылка;
			Строка.Применить = Ложь;
			// Сам заказ виден в колонке «Заказ в 1С», в пояснении только то, что про него надо знать.
			Если Резерв > 0 Тогда
				Строка.Пояснение = НСтр("ru = 'резерв 1'");
			ИначеЕсли Настройки.Резервировать Тогда
				Строка.Пояснение = НСтр("ru = 'без резерва: свободного остатка на складе нет'");
			Иначе
				Строка.Пояснение = НСтр("ru = 'без резерва'");
			КонецЕсли;
			Итог.Создано = Итог.Создано + 1;
		Исключение
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
			// Причину отказа УНФ сообщает сообщениями пользователю, в исключении только «Не удалось провести».
			Причины = Новый Массив;
			Причины.Добавить(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
				Причины.Добавить(Сообщение.Текст);
			КонецЦикла;
			Строка.Статус = "Ошибка";
			Строка.Пояснение = СтрСоединить(Причины, " ");
			Итог.Ошибок = Итог.Ошибок + 1;
			ЗаписьЖурналаРегистрации(СобытиеЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
				СтрШаблон("Задание %1: %2", Формат(Строка.ИдЗадания, "ЧГ=0"), ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;
	КонецЦикла;

	Итог.ВремяМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - Старт;
	ЗаписьЖурналаРегистрации(СобытиеЖурнала(), УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон("Заказы WB: создано %1, уже были %2, ошибок %3, за %4 с. Пользователь %5.", Итог.Создано, Итог.Пропущено, Итог.Ошибок,
			Формат(Итог.ВремяМс / 1000, "ЧДЦ=1; ЧН=0"), ИмяПользователя()));
	Возврат Итог;

КонецФункции

// Краткие итоги для формы и отчёта.
Функция ИтогЗаказов(Заказы) Экспорт

	Части = СчетчикиПоКолонке(Заказы, "Статус");
	Части.Вставить(0, СтрШаблон(НСтр("ru = 'Заданий WB: %1'"), Заказы.Количество()));
