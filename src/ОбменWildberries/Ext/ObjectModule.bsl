Функция ИзJSON(Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Попытка
		Результат = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Результат = Неопределено;
	КонецПопытки;
	Чтение.Закрыть();
	Возврат Результат;

