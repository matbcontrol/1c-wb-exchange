КонецФункции

Функция ИтогСтатусов(Статусы) Экспорт

	Отменено = Статусы.НайтиСтроки(Новый Структура("Отменен", Истина)).Количество();
	Закрыто = 0;
	Для Каждого Строка Из Статусы Цикл
		Если СтрНачинаетсяС(Строка.Действие, "Закрыт") Тогда
			Закрыто = Закрыто + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрШаблон(НСтр("ru = 'Проверено заказов: %1, отменено на WB: %2, закрыто в 1С: %3.'"), Статусы.Количество(), Отменено, Закрыто);

КонецФункции

// Строка для полосы состояния формы.
Функция ПредставлениеПрогресса(Состояние) Экспорт

	Если Состояние.Готово Тогда
		Если ЗначениеЗаполнено(Состояние.Ошибка) Тогда
			Возврат Состояние.Ошибка;
		КонецЕсли;
		Возврат СтрШаблон(НСтр("ru = 'Готово за %1 с: запросов к WB %2, повторов %3.'"),
			Формат(Состояние.ДлительностьМс / 1000, "ЧДЦ=1; ЧН=0"), Состояние.Запросов, Состояние.Повторов);
	КонецЕсли;
	Текст = СтрШаблон(НСтр("ru = '%1: запросов %2, в очереди %3'"), ПредставлениеФазы(Состояние.Фаза), Состояние.Запросов,
		Состояние.Очередь.Количество());
	Если Состояние.ЖдатьМс > 0 Тогда
		Текст = Текст + СтрШаблон(НСтр("ru = ', пауза %1 с по просьбе WB'"), Формат(Состояние.ЖдатьМс / 1000, "ЧДЦ=1; ЧН=0"));
	КонецЕсли;
	Возврат Текст;

