#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроверитьНастройки(Настройки, Операция)

	Ошибки = Новый Массив;
	Если Операция <> "СозданиеЗаказов" И ПустаяСтрока(Настройки.Токен) Тогда
		Ошибки.Добавить(НСтр("ru = 'Не указан токен API WB.'"));
	КонецЕсли;
	НужныЗаказы = (Операция = "Заказы" Или Операция = "ЗаказыЗаПериод" Или Операция = "Статусы" Или Операция = "СозданиеЗаказов");
	НужныОстатки = (Операция = "Остатки" Или Операция = "ВыгрузкаОстатков" Или Операция = "ОстаткиПолностью");
	Если НужныЗаказы И Не ЗначениеЗаполнено(Настройки.Контрагент) Тогда
		Ошибки.Добавить(НСтр("ru = 'Не указан контрагент Wildberries.'"));
	КонецЕсли;
	Если Операция = "СозданиеЗаказов" И Не ЗначениеЗаполнено(Настройки.Организация) Тогда
		Ошибки.Добавить(НСтр("ru = 'Не указана организация.'"));
	КонецЕсли;
	Если (Операция = "СозданиеЗаказов" Или НужныОстатки) И Не ЗначениеЗаполнено(Настройки.Склад) Тогда
		Ошибки.Добавить(НСтр("ru = 'Не указан склад 1С.'"));
	КонецЕсли;
	Если НужныОстатки И Настройки.СкладWB = 0 Тогда
		Ошибки.Добавить(НСтр("ru = 'Не указан ID склада продавца на WB.'"));
	КонецЕсли;
	Если Настройки.ПроцентОстатка < 0 Или Настройки.ПроцентОстатка > 100 Тогда
		Ошибки.Добавить(НСтр("ru = 'Процент остатка должен быть от 0 до 100.'"));
	КонецЕсли;
	Возврат Ошибки;

КонецФункции

// Соответствие: штрихкод -> Структура(Номенклатура, Характеристика).
Функция ТоварыПоШтрихкодам(Штрихкоды)

	Результат = Новый Соответствие;
	Если Штрихкоды.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Штрихкоды.Штрихкод КАК Штрихкод,
	|	Штрихкоды.Номенклатура КАК Номенклатура,
	|	Штрихкоды.Характеристика КАК Характеристика
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Штрихкод В (&Штрихкоды)
	|	И НЕ Штрихкоды.Номенклатура.ПометкаУдаления");
	Запрос.УстановитьПараметр("Штрихкоды", Штрихкоды);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Штрихкод, Новый Структура("Номенклатура, Характеристика", Выборка.Номенклатура, Выборка.Характеристика));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Соответствие: ВРЕГ(артикул) -> Массив из Структура(Номенклатура, Характеристика, ПоХарактеристикам).
// ПоХарактеристикам: товар учитывается по характеристикам, по одному артикулу его размер не определить.
Функция ТоварыПоАртикулам(Артикулы)

	Результат = Новый Соответствие;
	Если Артикулы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Номенклатура.Артикул КАК Артикул,
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	Номенклатура.ИспользоватьХарактеристики КАК ПоХарактеристикам
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Артикул В (&Артикулы)
	|	И НЕ Номенклатура.ПометкаУдаления
	|	И НЕ Номенклатура.ЭтоГруппа");
	Запрос.УстановитьПараметр("Артикулы", Артикулы);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = ВРег(СокрЛП(Выборка.Артикул));
		Список = Результат.Получить(Ключ);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Результат.Вставить(Ключ, Список);
		КонецЕсли;
		Список.Добавить(Новый Структура("Номенклатура, Характеристика, ПоХарактеристикам", Выборка.Номенклатура,
			Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка(), Выборка.ПоХарактеристикам = Истина));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция НоваяОчередь()

	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Сервис", ОписаниеСтроки(20));
	Т.Колонки.Добавить("Метод", ОписаниеСтроки(10));
	Т.Колонки.Добавить("Путь", ОписаниеСтроки(500));
	Т.Колонки.Добавить("Тело");
	Т.Колонки.Добавить("Обработчик", ОписаниеСтроки(50));
	Т.Колонки.Добавить("Параметр");
	Т.Колонки.Добавить("Попыток", ОписаниеЧисла(5, 0));
	Т.Колонки.Добавить("НеРаньше", ОписаниеЧисла(20, 0));
	Возврат Т;

КонецФункции

Функция НоваяТаблицаРазмеров()

	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("nmID", ОписаниеЧисла(15, 0));
	Т.Колонки.Добавить("chrtID", ОписаниеЧисла(15, 0));
	Т.Колонки.Добавить("АртикулПродавца", ОписаниеСтроки(100));
