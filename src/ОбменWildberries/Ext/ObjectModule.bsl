КонецФункции

Функция ТаблицаПоОбразцу(Источник, Образец)

	Для Каждого Строка Из Источник Цикл
		ЗаполнитьЗначенияСвойств(Образец.Добавить(), Строка);
	КонецЦикла;
	Возврат Образец;

КонецФункции

Функция РазбитьНаПачки(Элементы, Размер)

	Пачки = Новый Массив;
	Пачка = Новый Массив;
	Для Каждого Элемент Из Элементы Цикл
		Пачка.Добавить(Элемент);
		Если Пачка.Количество() >= Размер Тогда
			Пачки.Добавить(Пачка);
			Пачка = Новый Массив;
		КонецЕсли;
	КонецЦикла;
	Если Пачка.Количество() > 0 Тогда
		Пачки.Добавить(Пачка);
	КонецЕсли;
	Возврат Пачки;

КонецФункции

// Массив строк «статус N» в порядке первого появления статуса в таблице.
Функция СчетчикиПоКолонке(Таблица, Колонка)

	Счет = Новый Соответствие;
	Порядок = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Значение = СтрокаТаблицы[Колонка];
		Если Счет.Получить(Значение) = Неопределено Тогда
			Счет.Вставить(Значение, 0);
			Порядок.Добавить(Значение);
		КонецЕсли;
		Счет.Вставить(Значение, Счет.Получить(Значение) + 1);
	КонецЦикла;
	Части = Новый Массив;
	Для Каждого Значение Из Порядок Цикл
		Текст = ?(ЗначениеЗаполнено(Значение), Значение, "без статуса");
		// Строчной делается только первая буква: «отклонено WB», а не «отклонено wb».
		Части.Добавить(НРег(Лев(Текст, 1)) + Сред(Текст, 2) + " " + Счет.Получить(Значение));
	КонецЦикла;
	Возврат Части;

КонецФункции

Процедура ДобавитьСообщение(Состояние, Текст)

	Если ЗначениеЗаполнено(Текст) Тогда
		Состояние.Сообщения.Добавить(Формат(ТекущаяДатаСеанса(), "ДФ=ЧЧ:мм:сс") + " " + Текст);
	КонецЕсли;

КонецПроцедуры

Функция ДатаИзRFC3339(Текст)

	Если ПустаяСтрока(Текст) Или СтрДлина(Текст) < 19 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Попытка
		Универсальная = XMLЗначение(Тип("Дата"), Лев(Текст, 19));
		Возврат МестноеВремя(Универсальная, ЧасовойПоясСеанса());
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;

КонецФункции

Функция ДатаИзСтрокиДДММГГГГ(Текст)

	Части = СтрРазделить(СокрЛП(Текст), ".");
	Если Части.Количество() <> 3 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Попытка
		Возврат Дата(Число(Части[2]), Число(Части[1]), Число(Части[0]));
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;

КонецФункции

Функция ВUnix(МестнаяДата)

	Возврат Формат(УниверсальноеВремя(МестнаяДата, ЧасовойПоясСеанса()) - Дата(1970, 1, 1), "ЧН=0; ЧГ=0");

КонецФункции

Функция ЧислоИзСтроки(Знач Текст)

	Если ТипЗнч(Текст) = Тип("Число") Тогда
		Возврат Текст;
	КонецЕсли;
	Текст = СокрЛП(Строка(Текст));
	Если ПустаяСтрока(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Позиция, 1)) = 0 Тогда
			Возврат 0;
		КонецЕсли;
	КонецЦикла;
	Возврат Число(Текст);

КонецФункции

