Функция Поле(Объект, Ключ, ПоУмолчанию = Неопределено)

	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Значение = Объект.Получить(Ключ);
