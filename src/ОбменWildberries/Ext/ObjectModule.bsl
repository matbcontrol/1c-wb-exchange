// Состояния заданий на WB, при которых заказ в 1С надо закрыть как отменённый.
Функция ЗаданиеОтменено(СтатусПродавца, СтатусWB) Экспорт

	Отмены = СтрРазделить("canceled,canceled_by_client,declined_by_client,defect,canceled_by_carrier", ",");
	Возврат СтатусПродавца = "cancel" Или СтатусПродавца = "cancel_carrier" Или Отмены.Найти(СтатусWB) <> Неопределено;

КонецФункции

// Сколько выгрузить на WB при данном свободном остатке: процент от остатка минус страховой запас,
// не меньше нуля и не больше лимита WB 100 000, дробное округляется вниз.
Функция ОстатокКВыгрузке(Свободно, Настройки) Экспорт

	Значение = Цел(Макс(Свободно, 0) * Настройки.ПроцентОстатка / 100) - Настройки.СтраховойЗапас;
	Возврат Мин(Макс(Значение, 0), 100000);

КонецФункции

#КонецОбласти

#Область Фазы

Функция ПланФаз(Операция)

	Если Операция = "Склады" Тогда
		Список = "Склады";
	ИначеЕсли Операция = "Заказы" Тогда
		Список = "НовыеЗаказы,СопоставлениеЗаказов";
	ИначеЕсли Операция = "ЗаказыЗаПериод" Тогда
		Список = "СтраницыЗаказов,СопоставлениеЗаказов";
	ИначеЕсли Операция = "Статусы" Тогда
		Список = "ЗапросСтатусов,ЗакрытиеОтмененных";
	ИначеЕсли Операция = "Остатки" Тогда
		Список = "Карточки,ОстаткиWB,Сравнение";
	ИначеЕсли Операция = "ВыгрузкаОстатков" Тогда
		Список = "Отправка,Проверка,ИтогВыгрузки";
	ИначеЕсли Операция = "ОстаткиПолностью" Тогда
		Список = "Карточки,ОстаткиWB,Сравнение,Отправка,Проверка,ИтогВыгрузки";
	Иначе
		Возврат Новый Массив;
	КонецЕсли;
	Возврат СтрРазделить(Список, ",");

КонецФункции

Процедура ВыполнитьФазу(Состояние, Фаза)

	Настройки = Состояние.Настройки;

	Если Фаза = "Склады" Тогда
		ДобавитьЗапрос(Состояние, "marketplace", "GET", "/api/v3/warehouses", , "Склады");

	ИначеЕсли Фаза = "НовыеЗаказы" Тогда
		ДобавитьЗапрос(Состояние, "marketplace", "GET", "/api/v3/orders/new", , "Заказы");

	ИначеЕсли Фаза = "СтраницыЗаказов" Тогда
		// WB отдаёт не больше 30 дней одним запросом, длинный период режем на окна.
		НачалоОкна = Состояние.Период.Начало;
		Пока НачалоОкна <= Состояние.Период.Конец Цикл
			КонецОкна = Мин(НачалоОкна + 30 * 86400 - 1, Состояние.Период.Конец);
			Окно = Новый Структура("От, До", ВUnix(НачалоОкна), ВUnix(КонецОкна));
			ДобавитьЗапрос(Состояние, "marketplace", "GET", ПутьСтраницыЗаказов(Настройки.СтраницаЗаказов, 0, Окно), , "СтраницаЗаказов", Окно);
			НачалоОкна = КонецОкна + 1;
		КонецЦикла;

	ИначеЕсли Фаза = "СопоставлениеЗаказов" Тогда
		СопоставитьЗаказы(Состояние);

	ИначеЕсли Фаза = "ЗапросСтатусов" Тогда
		ВыбратьЗаказыДляСтатусов(Состояние);

	ИначеЕсли Фаза = "ЗакрытиеОтмененных" Тогда
		ЗакрытьОтмененныеЗаказы(Состояние);

	ИначеЕсли Фаза = "Карточки" Тогда
		ДобавитьЗапрос(Состояние, "content", "POST", "/content/v2/get/cards/list",
			ВJSON(ТелоСтраницыКарточек(Настройки.СтраницаКарточек, Неопределено)), "Карточки");

	ИначеЕсли Фаза = "ОстаткиWB" Тогда
		ПодготовитьОстатки(Состояние);

	ИначеЕсли Фаза = "Сравнение" Тогда
		СравнитьОстатки(Состояние);

	ИначеЕсли Фаза = "Отправка" Тогда
		ОтправитьОстатки(Состояние);

	ИначеЕсли Фаза = "Проверка" Тогда
		ПроверитьОтправленные(Состояние);

	ИначеЕсли Фаза = "ИтогВыгрузки" Тогда
		ПодвестиИтогВыгрузки(Состояние);

	КонецЕсли;

КонецПроцедуры

Процедура ЗавершитьОперацию(Состояние)

	Состояние.Готово = Истина;
	Состояние.ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - Состояние.Начало;
	Если Состояние.Операция = "Заказы" Или Состояние.Операция = "ЗаказыЗаПериод" Тогда
		Итог = ИтогЗаказов(Состояние.Заказы);
	ИначеЕсли Состояние.Операция = "Статусы" Тогда
		Итог = ИтогСтатусов(Состояние.Статусы);
	ИначеЕсли Состояние.Операция = "Склады" Тогда
		Итог = СтрШаблон(НСтр("ru = 'Складов продавца на WB: %1.'"), Состояние.Склады.Количество());
	Иначе
		Итог = ИтогОстатков(Состояние.Остатки);
	КонецЕсли;
	ДобавитьСообщение(Состояние, Итог);
	ЗаписьЖурналаРегистрации(СобытиеЖурнала(), УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон("%1: %2 Запросов %3, повторов %4, пауз %5 мс, всего %6 мс.", Состояние.Операция, Итог,
			Состояние.Запросов, Состояние.Повторов, Состояние.ПаузМс, Состояние.ДлительностьМс));

КонецПроцедуры

Процедура Остановить(Состояние, Текст)

	Состояние.Ошибка = Текст;
	Состояние.Готово = Истина;
	Состояние.Очередь.Очистить();
	Состояние.ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - Состояние.Начало;
	ЗаписьЖурналаРегистрации(СобытиеЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
		СтрШаблон("%1 (этап «%2»): %3", Состояние.Операция, ПредставлениеФазы(Состояние.Фаза), Текст));

КонецПроцедуры

Функция ПредставлениеФазы(Фаза)

	Имена = Новый Соответствие;
	Имена.Вставить("Склады", "Склады WB");
	Имена.Вставить("НовыеЗаказы", "Новые задания WB");
	Имена.Вставить("СтраницыЗаказов", "Задания за период");
	Имена.Вставить("СопоставлениеЗаказов", "Поиск товаров в 1С");
	Имена.Вставить("ЗапросСтатусов", "Статусы заданий");
	Имена.Вставить("ЗакрытиеОтмененных", "Закрытие отменённых");
	Имена.Вставить("Карточки", "Карточки товаров WB");
	Имена.Вставить("ОстаткиWB", "Остатки на WB");
	Имена.Вставить("Сравнение", "Сравнение остатков");
	Имена.Вставить("Отправка", "Отправка остатков");
	Имена.Вставить("Проверка", "Сверка после отправки");
	Имена.Вставить("ИтогВыгрузки", "Итог выгрузки");
	Имя = Имена.Получить(Фаза);
	Возврат ?(Имя = Неопределено, Фаза, Имя);

КонецФункции

#КонецОбласти

#Область Заказы

Процедура СопоставитьЗаказы(Состояние)

	Заказы = Состояние.Заказы;
	Если Заказы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Настройки = Состояние.Настройки;

	Штрихкоды = Новый Массив;
	Артикулы = Новый Массив;
	Для Каждого Строка Из Заказы Цикл
		Для Каждого Штрихкод Из СтрРазделить(Строка.Штрихкоды, ",", Ложь) Цикл
			Штрихкоды.Добавить(Штрихкод);
		КонецЦикла;
		Если ЗначениеЗаполнено(Строка.Артикул) Тогда
			Артикулы.Добавить(Строка.Артикул);
		КонецЕсли;
	КонецЦикла;
	ПоШтрихкоду = ТоварыПоШтрихкодам(Штрихкоды);
	ПоАртикулу = ТоварыПоАртикулам(Артикулы);

	Номера = Заказы.ВыгрузитьКолонку("ИдЗадания");
	Загруженные = НайтиЗагруженныеЗаказы(Настройки.Контрагент, Номера);
	Загруженные.Индексы.Добавить("ИдЗадания");

	Для Каждого Строка Из Заказы Цикл
		Строка.Применить = Ложь;

		Был = Загруженные.Найти(Строка.ИдЗадания, "ИдЗадания");
		Если Был <> Неопределено Тогда
			Строка.Статус = СтатусЗаказаУжеЗагружен();
			Строка.Заказ1С = Был.Заказ;
			Строка.Пояснение = "";
			Продолжить;
		КонецЕсли;

		Если Настройки.СкладWB <> 0 И Строка.СкладWB <> Настройки.СкладWB Тогда
			Строка.Статус = "Другой склад WB";
			Строка.Пояснение = СтрШаблон(НСтр("ru = 'Задание со склада WB %1, обмен настроен на склад %2'"),
				Формат(Строка.СкладWB, "ЧГ=0"), Формат(Настройки.СкладWB, "ЧГ=0"));
			Продолжить;
		КонецЕсли;

		Найден = Неопределено;
		Для Каждого Штрихкод Из СтрРазделить(Строка.Штрихкоды, ",", Ложь) Цикл
			Найден = ПоШтрихкоду.Получить(Штрихкод);
			Если Найден <> Неопределено Тогда
				Строка.КакНайден = "штрихкод";
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Найден = Неопределено И ЗначениеЗаполнено(Строка.Артикул) Тогда
			Кандидаты = ПоАртикулу.Получить(ВРег(СокрЛП(Строка.Артикул)));
			Если Кандидаты <> Неопределено И Кандидаты.Количество() > 1 Тогда
				Строка.Статус = "Неоднозначно";
				Строка.Пояснение = СтрШаблон(НСтр("ru = 'Артикул «%1» есть у %2 товаров в 1С, добавьте штрихкод WB к нужному товару'"),
					Строка.Артикул, Кандидаты.Количество());
				Продолжить;
			ИначеЕсли Кандидаты <> Неопределено И Кандидаты[0].ПоХарактеристикам Тогда
				// Без характеристики УНФ заказ не проведёт, а угадывать размер по артикулу нельзя.
				Строка.Статус = "Неоднозначно";
				Строка.Пояснение = СтрШаблон(НСтр("ru = 'Товар в 1С учитывается по характеристикам, по артикулу размер не определить: добавьте штрихкод WB %1 к нужной характеристике'"),
					Строка.Штрихкоды);
				Продолжить;
			ИначеЕсли Кандидаты <> Неопределено Тогда
				Найден = Кандидаты[0];
				Строка.КакНайден = "артикул";
			КонецЕсли;
		КонецЕсли;

		Если Найден = Неопределено Тогда
			Строка.Статус = "Товар не найден";
			Строка.Пояснение = СтрШаблон(НСтр("ru = 'Нет товара с артикулом «%1» или штрихкодом %2'"), Строка.Артикул, Строка.Штрихкоды);
			Продолжить;
		КонецЕсли;

		Строка.Номенклатура = Найден.Номенклатура;
		Строка.Характеристика = Найден.Характеристика;
		Строка.Статус = СтатусЗаказаНовый();
		Строка.Применить = Истина;
		Пояснения = Новый Массив;
		Если Строка.НулевойОстаток Тогда
			Пояснения.Добавить(НСтр("ru = 'заказ при нулевом остатке на WB, его можно отменить без штрафа'"));
		КонецЕсли;
		Если Строка.ВалютаПродажи <> 0 И Строка.ВалютаПродажи <> 643 Тогда
			Пояснения.Добавить(СтрШаблон(НСтр("ru = 'продажа в валюте %1, цена пересчитана WB в рубли'"), Строка.ВалютаПродажи));
		КонецЕсли;
		Строка.Пояснение = СтрСоединить(Пояснения, "; ");
	КонецЦикла;

КонецПроцедуры

// Загруженные ранее заказы: номер задания WB хранится в «Номере входящего документа».
Функция НайтиЗагруженныеЗаказы(Контрагент, ИдЗаданий) Экспорт

	Номера = Новый Массив;
	Для Каждого Ид Из ИдЗаданий Цикл
		Номера.Добавить(Формат(Ид, "ЧГ=0"));
	КонецЦикла;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Заказ.Ссылка КАК Заказ,
	|	Заказ.НомерВходящегоДокумента КАК Номер
	|ИЗ
	|	Документ.ЗаказПокупателя КАК Заказ
	|ГДЕ
	|	Заказ.Контрагент = &Контрагент
	|	И Заказ.НомерВходящегоДокумента В (&Номера)
	|	И НЕ Заказ.ПометкаУдаления");
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Номера", Номера);
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Заказ");
	Результат.Колонки.Добавить("ИдЗадания", ОписаниеЧисла(15, 0));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Результат.Добавить();
		Строка.Заказ = Выборка.Заказ;
		Строка.ИдЗадания = ЧислоИзСтроки(Выборка.Номер);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Заказ заполняется так же, как во встроенном обмене УНФ с Ozon и Яндекс Маркетом:
// Заполнить() по организации и контрагенту, затем склад продажи и резерва, номер и дата
// задания в реквизитах входящего документа, ставка НДС по настройкам организации.
Функция НовыйЗаказПокупателя(Строка, Настройки, ЕдиницаИзмерения, НастройкиНДС, Резерв)

	Документ = Документы.ЗаказПокупателя.СоздатьДокумент();
	ДанныеЗаполнения = Новый Структура("Организация, Контрагент", Настройки.Организация, Настройки.Контрагент);
	Если ЗначениеЗаполнено(Настройки.Договор) Тогда
		ДанныеЗаполнения.Вставить("Договор", Настройки.Договор);
	КонецЕсли;
	Документ.Заполнить(ДанныеЗаполнения);

	Документ.Дата = ТекущаяДатаСеанса();
	Документ.Организация = Настройки.Организация;
	Документ.Контрагент = Настройки.Контрагент;
	Если ЗначениеЗаполнено(Настройки.Договор) Тогда
		Документ.Договор = Настройки.Договор;
	КонецЕсли;
	Если ЗначениеЗаполнено(Настройки.СостояниеЗаказа) Тогда
		Документ.СостояниеЗаказа = Настройки.СостояниеЗаказа;
	КонецЕсли;
	Документ.СтруктурнаяЕдиницаПродажи = Настройки.Склад;
	Документ.СтруктурнаяЕдиницаРезерв = Настройки.Склад;
	Документ.ДатаОтгрузки = ?(ЗначениеЗаполнено(Строка.ДатаОтгрузки), Строка.ДатаОтгрузки, ТекущаяДатаСеанса());
	Документ.НомерВходящегоДокумента = Формат(Строка.ИдЗадания, "ЧГ=0");
	Документ.ДатаВходящегоДокумента = Строка.ДатаЗаказа;

	Комментарий = Новый Массив;
	Комментарий.Добавить(СтрШаблон(НСтр("ru = 'Загружен из Wildberries: сборочное задание №%1 от %2, артикул WB %3'"),
		Формат(Строка.ИдЗадания, "ЧГ=0"), Формат(Строка.ДатаЗаказа, "ДФ='дд.ММ.гггг ЧЧ:мм'"), Формат(Строка.АртикулWB, "ЧГ=0")));
	Если ЗначениеЗаполнено(Строка.КомментарийПокупателя) Тогда
		Комментарий.Добавить(НСтр("ru = 'Покупатель: '") + Строка.КомментарийПокупателя);
	КонецЕсли;
	Если ЗначениеЗаполнено(Строка.Пояснение) Тогда
		Комментарий.Добавить(Строка.Пояснение);
	КонецЕсли;
	Если Настройки.Резервировать И Резерв = 0 Тогда
		Комментарий.Добавить(НСтр("ru = 'Свободного остатка на складе не было, заказ создан без резерва'"));
	КонецЕсли;
	Документ.Комментарий = СтрСоединить(Комментарий, Символы.ПС);

	СтрокаТовара = Документ.Запасы.Добавить();
	СтрокаТовара.Номенклатура = Строка.Номенклатура;
	СтрокаТовара.Характеристика = Строка.Характеристика;
	СтрокаТовара.ТипНоменклатурыЗапас = Истина;
	СтрокаТовара.ЕдиницаИзмерения = ЕдиницаИзмерения;
	СтрокаТовара.Количество = 1;
	СтрокаТовара.Резерв = Резерв;
	СтрокаТовара.Цена = Строка.Цена;
	СтрокаТовара.Сумма = Строка.Цена;
	СтрокаТовара.СтруктурнаяЕдиницаРезерв = Настройки.Склад;
	СтрокаТовара.КлючСвязи = 1;
	СтрокаТовара.ДатаОтгрузки = Документ.ДатаОтгрузки;
	СтрокаТовара.Содержание = СтрШаблон("WB %1 / %2", Формат(Строка.АртикулWB, "ЧГ=0"), Строка.Артикул);
	НоменклатураВДокументахСервер.ОбновитьСтавкуНДСТабличнойЧасти(Документ, "Запасы", Истина, НастройкиНДС.ВидСтавкиНДС);

	Если Не Документ.ПроверитьЗаполнение() Тогда
		Тексты = Новый Массив;
		Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
			Тексты.Добавить(Сообщение.Текст);
		КонецЦикла;
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Заказ не прошёл проверку заполнения: %1'"), СтрСоединить(Тексты, "; "));
	КонецЕсли;
	Документ.Записать(РежимЗаписиДокумента.Проведение);
	Возврат Документ;

КонецФункции

Процедура ВыбратьЗаказыДляСтатусов(Состояние)

	Настройки = Состояние.Настройки;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Заказ.Ссылка КАК Заказ,
	|	Заказ.НомерВходящегоДокумента КАК Номер
	|ИЗ
	|	Документ.ЗаказПокупателя КАК Заказ
	|ГДЕ
	|	Заказ.Контрагент = &Контрагент
	|	И Заказ.НомерВходящегоДокумента <> """"
	|	И Заказ.Проведен
	|	И Заказ.СостояниеЗаказа <> ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовПокупателей.Завершен)
	|	И Заказ.Дата >= &С
	|УПОРЯДОЧИТЬ ПО
	|	Заказ.Дата");
	Запрос.УстановитьПараметр("Контрагент", Настройки.Контрагент);
	Запрос.УстановитьПараметр("С", ТекущаяДатаСеанса() - Настройки.ДнейСтатусов * 86400);
	Выборка = Запрос.Выполнить().Выбрать();
	Ид = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Номер = ЧислоИзСтроки(Выборка.Номер);
		Если Номер = 0 Тогда
			Продолжить;
		КонецЕсли;
		Строка = Состояние.Статусы.Добавить();
		Строка.Заказ1С = Выборка.Заказ;
		Строка.ИдЗадания = Номер;
		Ид.Добавить(Номер);
	КонецЦикла;

	// В одном запросе статусов не больше 1000 заданий.
	Для Каждого Пачка Из РазбитьНаПачки(Ид, 1000) Цикл
		ДобавитьЗапрос(Состояние, "marketplace", "POST", "/api/v3/orders/status", ВJSON(Новый Структура("orders", Пачка)), "Статусы");
	КонецЦикла;

КонецПроцедуры

Процедура ЗакрытьОтмененныеЗаказы(Состояние)

	Для Каждого Строка Из Состояние.Статусы Цикл
		Если Не ЗначениеЗаполнено(Строка.СтатусПродавца) И Не ЗначениеЗаполнено(Строка.СтатусWB) Тогда
			Строка.Действие = НСтр("ru = 'WB не вернул статус: задание старше 3 месяцев или удалено'");
			Продолжить;
		КонецЕсли;
		Строка.Отменен = ЗаданиеОтменено(Строка.СтатусПродавца, Строка.СтатусWB);
		Если Не Строка.Отменен Тогда
			Строка.Действие = СтрШаблон(НСтр("ru = 'На WB: %1 / %2'"), Строка.СтатусПродавца, Строка.СтатусWB);
			Продолжить;
		КонецЕсли;
		Если Не Состояние.Настройки.ЗакрыватьОтмененные Тогда
			Строка.Действие = НСтр("ru = 'Отменён на WB, закрытие выключено в настройках'");
			Продолжить;
		КонецЕсли;
		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("Документ.ЗаказПокупателя");
			ЭлементБлокировки.УстановитьЗначение("Ссылка", Строка.Заказ1С);
			Блокировка.Заблокировать();
			Документ = Строка.Заказ1С.ПолучитьОбъект();
			Документ.СостояниеЗаказа = Справочники.СостоянияЗаказовПокупателей.Завершен;
			Документ.ВариантЗавершения = Перечисления.ВариантыЗавершенияЗаказа.Отменен;
			Документ.Комментарий = СокрЛП(Документ.Комментарий + Символы.ПС
				+ СтрШаблон(НСтр("ru = 'Отменён на Wildberries (%1 / %2), закрыт обменом %3'"), Строка.СтатусПродавца, Строка.СтатусWB,
					Формат(ТекущаяДатаСеанса(), "ДЛФ=DT")));
			Документ.Записать(РежимЗаписиДокумента.Проведение);
			ЗафиксироватьТранзакцию();
			Строка.Действие = НСтр("ru = 'Закрыт как отменённый, резерв снят'");
		Исключение
			ОтменитьТранзакцию();
			Строка.Действие = НСтр("ru = 'Не удалось закрыть: '") + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Остатки

// Сопоставляет размеры WB с товарами 1С, считает свободный остаток и ставит в очередь
// чтение текущих остатков на складе WB.
Процедура ПодготовитьОстатки(Состояние)

	Настройки = Состояние.Настройки;
	Остатки = Состояние.Остатки;
	Остатки.Очистить();

	Штрихкоды = Новый Массив;
	Артикулы = Новый Массив;
	Для Каждого Размер Из Состояние.Карточки Цикл
		Для Каждого Штрихкод Из СтрРазделить(Размер.Штрихкоды, ",", Ложь) Цикл
			Штрихкоды.Добавить(Штрихкод);
		КонецЦикла;
		Если ЗначениеЗаполнено(Размер.АртикулПродавца) Тогда
			Артикулы.Добавить(Размер.АртикулПродавца);
		КонецЕсли;
	КонецЦикла;
	ПоШтрихкоду = ТоварыПоШтрихкодам(Штрихкоды);
	ПоАртикулу = ТоварыПоАртикулам(Артикулы);

	Для Каждого Размер Из Состояние.Карточки Цикл
		Строка = Остатки.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Размер);
		Найден = Неопределено;
		Для Каждого Штрихкод Из СтрРазделить(Размер.Штрихкоды, ",", Ложь) Цикл
			Найден = ПоШтрихкоду.Получить(Штрихкод);
			Если Найден <> Неопределено Тогда
				Строка.КакНайден = "штрихкод";
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Найден = Неопределено Тогда
			Кандидаты = ПоАртикулу.Получить(ВРег(СокрЛП(Размер.АртикулПродавца)));
			Если Кандидаты = Неопределено Тогда
				Строка.Статус = "Не сопоставлен";
				Строка.Пояснение = СтрШаблон(НСтр("ru = 'В 1С нет товара с артикулом «%1» или штрихкодом %2'"), Размер.АртикулПродавца, Размер.Штрихкоды);
				Продолжить;
			ИначеЕсли Кандидаты.Количество() > 1 Тогда
				Строка.Статус = "Не сопоставлен";
				Строка.Пояснение = СтрШаблон(НСтр("ru = 'Артикул «%1» есть у %2 товаров в 1С'"), Размер.АртикулПродавца, Кандидаты.Количество());
				Продолжить;
			ИначеЕсли Кандидаты[0].ПоХарактеристикам Тогда
				// Остаток такого товара лежит по характеристикам, угадывать размер по артикулу нельзя.
				Строка.Статус = "Не сопоставлен";
				Строка.Пояснение = СтрШаблон(НСтр("ru = 'Товар в 1С учитывается по характеристикам: добавьте штрихкод WB %1 к характеристике размера %2'"),
					Размер.Штрихкоды, ?(ЗначениеЗаполнено(Размер.Размер) И Размер.Размер <> "0", Размер.Размер, НСтр("ru = 'из карточки'")));
				Продолжить;
			ИначеЕсли Размер.РазмеровВКарточке > 1 Тогда
				Строка.Статус = "Не сопоставлен";
				Строка.Пояснение = СтрШаблон(НСтр("ru = 'У карточки %1 размера: для каждого размера заведите в 1С штрихкод WB, иначе остаток не разложить'"),
					Размер.РазмеровВКарточке);
				Продолжить;
			КонецЕсли;
			Найден = Кандидаты[0];
			Строка.КакНайден = "артикул";
		КонецЕсли;
		Строка.Номенклатура = Найден.Номенклатура;
		Строка.Характеристика = Найден.Характеристика;
	КонецЦикла;

	Товары = Новый Массив;
	Для Каждого Строка Из Остатки Цикл
		Если ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			Товары.Добавить(Строка.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Свободные = ТаблицаСвободныхОстатков(Товары, Настройки.Склад);

	Ид = Новый Массив;
	Для Каждого Строка Из Остатки Цикл
		Если Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Найдено = Свободные.НайтиСтроки(Новый Структура("Номенклатура, Характеристика", Строка.Номенклатура, Строка.Характеристика));
		Строка.Свободно = ?(Найдено.Количество() > 0, Найдено[0].Свободно, 0);
		Строка.КВыгрузке = ОстатокКВыгрузке(Строка.Свободно, Настройки);
		Ид.Добавить(Строка.chrtID);
	КонецЦикла;

	Путь = "/api/v3/stocks/" + Формат(Настройки.СкладWB, "ЧГ=0");
	Для Каждого Пачка Из РазбитьНаПачки(Ид, Мин(Настройки.РазмерПачки, 1000)) Цикл
		ДобавитьЗапрос(Состояние, "marketplace", "POST", Путь, ВJSON(Новый Структура("chrtIds", Пачка)), "ОстаткиWB");
	КонецЦикла;

КонецПроцедуры

// Свободный остаток склада: без резерва под заказы, как во встроенном обмене УНФ с Ozon.
// Колонки Номенклатура, Характеристика, Свободно; индекс по товару и характеристике.
Функция ТаблицаСвободныхОстатков(Товары, Склад)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Запасы.Номенклатура КАК Номенклатура,
	|	Запасы.Характеристика КАК Характеристика,
	|	СУММА(Запасы.КоличествоОстаток) КАК Свободно
	|ИЗ
	|	РегистрНакопления.Запасы.Остатки(
	|			,
	|			СтруктурнаяЕдиница = &Склад
	|				И ЗаказПокупателя = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|				И Номенклатура В (&Товары)) КАК Запасы
	|
	|СГРУППИРОВАТЬ ПО
	|	Запасы.Номенклатура,
	|	Запасы.Характеристика");
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Товары", Товары);
	Свободные = Запрос.Выполнить().Выгрузить();
	Свободные.Индексы.Добавить("Номенклатура, Характеристика");
	Возврат Свободные;

КонецФункции

Процедура СравнитьОстатки(Состояние)

	Для Каждого Строка Из Состояние.Остатки Цикл
		Если Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			Строка.Выгрузить = Ложь;
			Продолжить;
		КонецЕсли;
		Если Строка.КВыгрузке = Строка.НаWB Тогда
			Строка.Статус = "Без изменений";
			Строка.Выгрузить = Ложь;
		Иначе
			Строка.Статус = "Изменится";
			Строка.Выгрузить = Истина;
			Строка.Пояснение = СтрШаблон(НСтр("ru = 'на WB %1 → %2'"), ?(Строка.ЕстьНаWB, Строка.НаWB, НСтр("ru = 'нет записи'")), Строка.КВыгрузке);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ОтправитьОстатки(Состояние)

	Отправить = Новый Массив;
	Для Каждого Строка Из Состояние.Остатки Цикл
		Если Строка.Выгрузить И Строка.Статус = "Изменится" Тогда
			Отправить.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	Путь = "/api/v3/stocks/" + Формат(Состояние.Настройки.СкладWB, "ЧГ=0");
	Для Каждого Пачка Из РазбитьНаПачки(Отправить, Мин(Состояние.Настройки.РазмерПачки, 1000)) Цикл
		Позиции = Новый Массив;
		Ид = Новый Массив;
		Для Каждого Строка Из Пачка Цикл
			Позиции.Добавить(Новый Структура("chrtId, amount", Строка.chrtID, Строка.КВыгрузке));
			Ид.Добавить(Строка.chrtID);
			Строка.Отправлено = Строка.КВыгрузке;
		КонецЦикла;
		ДобавитьЗапрос(Состояние, "marketplace", "PUT", Путь, ВJSON(Новый Структура("stocks", Позиции)), "Отправка", Ид);
	КонецЦикла;

КонецПроцедуры

// WB предупреждает: неверное имя поля в запросе даёт 204 без изменений. Поэтому каждую
// отправленную позицию перечитываем и сравниваем с тем, что отправили.
Процедура ПроверитьОтправленные(Состояние)

	Ид = Новый Массив;
	Для Каждого Строка Из Состояние.Остатки Цикл
		Если Строка.Статус = "Отправлено" Тогда
			Ид.Добавить(Строка.chrtID);
		КонецЕсли;
	КонецЦикла;
	Путь = "/api/v3/stocks/" + Формат(Состояние.Настройки.СкладWB, "ЧГ=0");
	Для Каждого Пачка Из РазбитьНаПачки(Ид, Мин(Состояние.Настройки.РазмерПачки, 1000)) Цикл
		ДобавитьЗапрос(Состояние, "marketplace", "POST", Путь, ВJSON(Новый Структура("chrtIds", Пачка)), "Проверка", Пачка);
	КонецЦикла;

КонецПроцедуры

Процедура ПодвестиИтогВыгрузки(Состояние)

	Выгружено = 0;
	Ошибок = 0;
	Для Каждого Строка Из Состояние.Остатки Цикл
		Если Строка.Статус = "Отправлено" Тогда
			// Позиция не вернулась при сверке.
			Строка.Статус = "Не подтверждено";
			Строка.Пояснение = НСтр("ru = 'WB ответил успешно, но при сверке остаток не найден'");
		КонецЕсли;
		Если Строка.Статус = "Выгружено" Тогда
			Выгружено = Выгружено + 1;
		ИначеЕсли Строка.Статус = "Отклонено WB" Или Строка.Статус = "Не подтверждено" Тогда
			Ошибок = Ошибок + 1;
		КонецЕсли;
	КонецЦикла;
	ЗаписьЖурналаРегистрации(СобытиеЖурнала(), ?(Ошибок > 0, УровеньЖурналаРегистрации.Предупреждение, УровеньЖурналаРегистрации.Информация), , ,
		СтрШаблон("Остатки на склад WB %1: выгружено и подтверждено %2, с ошибками %3.", Формат(Состояние.Настройки.СкладWB, "ЧГ=0"),
			Выгружено, Ошибок));

КонецПроцедуры

Функция ПояснениеОшибкиОстатка(Код, Сообщение)

	Если Код = "NotFound" Тогда
		Возврат НСтр("ru = 'Размер не найден на WB: карточка удалена или chrtId устарел'");
	ИначеЕсли Код = "SubjectRestriction" Тогда
		Возврат НСтр("ru = 'Товар этой категории нельзя продавать со склада продавца (FBS)'");
	ИначеЕсли Код = "DeliveryTypeRestriction" Тогда
		Возврат НСтр("ru = 'Склад WB не подходит по типу доставки, нужен склад FBS'");
	ИначеЕсли СтрНачинаетсяС(Код, "CargoWarehouseRestriction") Тогда
		Возврат НСтр("ru = 'Склад не подходит для габарита товара (МГТ, СГТ, КГТ)'");
	ИначеЕсли Код = "UploadDataLimit" Тогда
		Возврат НСтр("ru = 'Остаток больше лимита WB 100 000'");
	ИначеЕсли Код = "TnvedRequired" Тогда
		Возврат НСтр("ru = 'В карточке товара нужен код ТН ВЭД'");
	КонецЕсли;
	Возврат СокрЛП(Код + ": " + Сообщение);

КонецФункции

#КонецОбласти

#Область ОбработкаОтветов

Процедура ОбработатьОтвет(Состояние, Элемент, Ответ)

	Данные = Ответ.Данные;
	Обработчик = Элемент.Обработчик;

	Если Обработчик = "Склады" Тогда
		Если ТипЗнч(Данные) = Тип("Массив") Тогда
			Для Каждого Склад Из Данные Цикл
				Строка = Состояние.Склады.Добавить();
				Строка.Идентификатор = Число(Поле(Склад, "id", 0));
				Строка.Наименование = Поле(Склад, "name", "");
				Строка.СкладWB = Число(Поле(Склад, "officeId", 0));
				Строка.ТипДоставки = Число(Поле(Склад, "deliveryType", 0));
				Строка.ТипГруза = Число(Поле(Склад, "cargoType", 0));
				Строка.Удаляется = Поле(Склад, "isDeleting", Ложь) = Истина;
			КонецЦикла;
		КонецЕсли;

	ИначеЕсли Обработчик = "Карточки" Тогда
		Карточки = Поле(Данные, "cards", Новый Массив);
		Для Каждого Карточка Из Карточки Цикл
			Размеры = Поле(Карточка, "sizes", Новый Массив);
			Для Каждого Размер Из Размеры Цикл
				Строка = Состояние.Карточки.Добавить();
				Строка.nmID = Число(Поле(Карточка, "nmID", 0));
				Строка.АртикулПродавца = Поле(Карточка, "vendorCode", "");
				Строка.Наименование = Поле(Карточка, "title", "");
				Строка.chrtID = Число(Поле(Размер, "chrtID", 0));
				Строка.Размер = Поле(Размер, "techSize", "");
				Строка.Штрихкоды = СтрСоединить(Поле(Размер, "skus", Новый Массив), ",");
				Строка.РазмеровВКарточке = Размеры.Количество();
			КонецЦикла;
		КонецЦикла;
		// Пагинация из документации: курсор ответа копируется в запрос, пока total не станет меньше limit.
		Курсор = Поле(Данные, "cursor");
		Всего = Число(Поле(Курсор, "total", 0));
		Если Всего >= Состояние.Настройки.СтраницаКарточек И Карточки.Количество() > 0 Тогда
			Если Состояние.Карточки.Количество() > 500000 Тогда
				ВызватьИсключение НСтр("ru = 'Больше 500 000 размеров: похоже, WB зациклил пагинацию'");
			КонецЕсли;
			ДобавитьЗапрос(Состояние, "content", "POST", "/content/v2/get/cards/list",
				ВJSON(ТелоСтраницыКарточек(Состояние.Настройки.СтраницаКарточек, Курсор)), "Карточки");
		КонецЕсли;

	ИначеЕсли Обработчик = "Заказы" Или Обработчик = "СтраницаЗаказов" Тогда
		Заказы = Поле(Данные, "orders", Новый Массив);
		Для Каждого Заказ Из Заказы Цикл
			ДобавитьЗаказ(Состояние, Заказ);
		КонецЦикла;
		Если Обработчик = "СтраницаЗаказов" И Заказы.Количество() >= Состояние.Настройки.СтраницаЗаказов Тогда
			Следующий = Число(Поле(Данные, "next", 0));
			Если Следующий > 0 Тогда
				ДобавитьЗапрос(Состояние, "marketplace", "GET",
					ПутьСтраницыЗаказов(Состояние.Настройки.СтраницаЗаказов, Следующий, Элемент.Параметр), , "СтраницаЗаказов", Элемент.Параметр);
			КонецЕсли;
		КонецЕсли;

	ИначеЕсли Обработчик = "Статусы" Тогда
		Для Каждого Статус Из Поле(Данные, "orders", Новый Массив) Цикл
			Строка = Состояние.Статусы.Найти(Число(Поле(Статус, "id", 0)), "ИдЗадания");
			Если Строка <> Неопределено Тогда
				Строка.СтатусПродавца = Поле(Статус, "supplierStatus", "");
				Строка.СтатусWB = Поле(Статус, "wbStatus", "");
			КонецЕсли;
		КонецЦикла;

	ИначеЕсли Обработчик = "ОстаткиWB" Тогда
		Для Каждого Остаток Из Поле(Данные, "stocks", Новый Массив) Цикл
			Для Каждого Строка Из Состояние.Остатки.НайтиСтроки(Новый Структура("chrtID", Число(Поле(Остаток, "chrtId", 0)))) Цикл
				Строка.НаWB = Число(Поле(Остаток, "amount", 0));
				Строка.ЕстьНаWB = Истина;
			КонецЦикла;
		КонецЦикла;

	ИначеЕсли Обработчик = "Отправка" Тогда
		Отклонены = Новый Соответствие;
		Если Ответ.Код = 409 И ТипЗнч(Данные) = Тип("Массив") Тогда
			Для Каждого Ошибка Из Данные Цикл
				Код = Поле(Ошибка, "code", "");
				Для Каждого Позиция Из Поле(Ошибка, "data", Новый Массив) Цикл
					Отклонены.Вставить(Число(Поле(Позиция, "chrtId", 0)), ПояснениеОшибкиОстатка(Код, Поле(Ошибка, "message", "")));
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
		Для Каждого Ид Из Элемент.Параметр Цикл
			Для Каждого Строка Из Состояние.Остатки.НайтиСтроки(Новый Структура("chrtID", Ид)) Цикл
				Причина = Отклонены.Получить(Ид);
				Если Причина = Неопределено Тогда
					Строка.Статус = "Отправлено";
				Иначе
					Строка.Статус = "Отклонено WB";
					Строка.Пояснение = Причина;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;

	ИначеЕсли Обработчик = "Проверка" Тогда
		Пришли = Новый Соответствие;
		Для Каждого Остаток Из Поле(Данные, "stocks", Новый Массив) Цикл
			Пришли.Вставить(Число(Поле(Остаток, "chrtId", 0)), Число(Поле(Остаток, "amount", 0)));
		КонецЦикла;
		Для Каждого Ид Из Элемент.Параметр Цикл
			Для Каждого Строка Из Состояние.Остатки.НайтиСтроки(Новый Структура("chrtID", Ид)) Цикл
				Сейчас = Пришли.Получить(Ид);
				Если Сейчас = Неопределено Тогда
					Строка.Статус = "Не подтверждено";
					Строка.Пояснение = НСтр("ru = 'WB ответил успешно, но при сверке остатка нет'");
				ИначеЕсли Сейчас = Строка.Отправлено Тогда
					Строка.Статус = "Выгружено";
					Строка.НаWB = Сейчас;
					Строка.ЕстьНаWB = Истина;
					Строка.Пояснение = "";
				Иначе
					Строка.Статус = "Не подтверждено";
					Строка.Пояснение = СтрШаблон(НСтр("ru = 'WB ответил успешно, но на складе %1 вместо %2'"), Сейчас, Строка.Отправлено);
					Строка.НаWB = Сейчас;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;

	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьЗаказ(Состояние, Заказ)

	Ид = Число(Поле(Заказ, "id", 0));
	Если Ид = 0 Или Состояние.Заказы.Найти(Ид, "ИдЗадания") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Строка = Состояние.Заказы.Добавить();
	Строка.ИдЗадания = Ид;
	Строка.Rid = Поле(Заказ, "rid", "");
	Строка.Корзина = Поле(Заказ, "orderUid", "");
	Строка.ДатаЗаказа = ДатаИзRFC3339(Поле(Заказ, "createdAt", ""));
	Строка.ДатаОтгрузки = ДатаИзСтрокиДДММГГГГ(Поле(Заказ, "sellerDate", ""));
	Строка.Артикул = Поле(Заказ, "article", "");
	Строка.АртикулWB = Число(Поле(Заказ, "nmId", 0));
	Строка.РазмерWB = Число(Поле(Заказ, "chrtId", 0));
	Строка.Штрихкоды = СтрСоединить(Поле(Заказ, "skus", Новый Массив), ",");
	Строка.ВалютаПродажи = Число(Поле(Заказ, "currencyCode", 0));
	// Цена в копейках. Для продавца из России convertedPrice уже в рублях, даже если покупатель
	// платил в другой валюте.
	Если Число(Поле(Заказ, "convertedCurrencyCode", 643)) = 643 И Поле(Заказ, "convertedPrice") <> Неопределено Тогда
		Строка.Цена = Число(Поле(Заказ, "convertedPrice", 0)) / 100;
	Иначе
		Строка.Цена = Число(Поле(Заказ, "price", 0)) / 100;
	КонецЕсли;
	Строка.СкладWB = Число(Поле(Заказ, "warehouseId", 0));
	Строка.КомментарийПокупателя = Поле(Заказ, "comment", "");
	Строка.НулевойОстаток = Поле(Заказ, "isZeroOrder", Ложь) = Истина;

КонецПроцедуры

// Что делать с ответом: обработать, повторить позже или остановить операцию с понятной причиной.
Функция ОценитьОтвет(Ответ, Элемент)

	Решение = Новый Структура("Действие, ПаузаМс, Текст", "Обработать", 0, "");
	Код = Ответ.Код;
	Раздел = ?(Элемент.Сервис = "content", НСтр("ru = 'Контент'"), НСтр("ru = 'Маркетплейс'"));

	Если Код >= 200 И Код < 300 Тогда
		Возврат Решение;
	КонецЕсли;

	Если Код = 0 Тогда
		Решение.Действие = "Повторить";
		Решение.ПаузаМс = ПаузаПовтора(Элемент.Попыток);
		Решение.Текст = СтрШаблон(НСтр("ru = 'Нет связи с WB (%1), повтор через %2 с'"), Ответ.Ошибка, Решение.ПаузаМс / 1000);
	ИначеЕсли Код = 429 Тогда
		Секунд = ЧислоИзСтроки(Ответ.Заголовки.Получить("x-ratelimit-retry"));
		Решение.Действие = "Повторить";
		Решение.ПаузаМс = Макс(Секунд, 1) * 1000 + 100;
		Решение.Текст = СтрШаблон(НСтр("ru = 'WB просит подождать %1 с: лимит запросов'"), Макс(Секунд, 1));
	ИначеЕсли Код >= 500 Тогда
		Решение.Действие = "Повторить";
		Решение.ПаузаМс = ПаузаПовтора(Элемент.Попыток);
		Решение.Текст = СтрШаблон(НСтр("ru = 'WB ответил %1, повтор через %2 с'"), Код, Решение.ПаузаМс / 1000);
	ИначеЕсли Код = 409 И Элемент.Обработчик = "Отправка" Тогда
		Если ВсеОшибкиСКодом(Ответ.Данные, "StoreIsProcessing") Тогда
			Решение.Действие = "Повторить";
			Решение.ПаузаМс = 3000;
			Решение.Текст = НСтр("ru = 'Склад обновляется на стороне WB, повтор через 3 с'");
		КонецЕсли;
	ИначеЕсли Код = 406 Тогда
		Если Поле(Ответ.Данные, "code", "") = "WarehouseStocksUpdateBlock" Тогда
			Решение.Действие = "Повторить";
			Решение.ПаузаМс = 5000;
			Решение.Текст = НСтр("ru = 'На складе WB технические работы, повтор через 5 с'");
		Иначе
			Решение.Действие = "Остановить";
			Решение.Текст = СтрШаблон(НСтр("ru = 'WB запретил обновлять остатки: %1'"), ТекстОшибкиWB(Ответ));
		КонецЕсли;
	ИначеЕсли Код = 401 Тогда
		Решение.Действие = "Остановить";
		Решение.Текст = СтрШаблон(НСтр("ru = 'WB не принял токен: %1. Токен действует 180 дней, создайте новый в личном кабинете WB'"),
			ТекстОшибкиWB(Ответ));
	ИначеЕсли Код = 403 Тогда
		Решение.Действие = "Остановить";
		Если СтрНайти(НРег(Ответ.Текст), "scope") > 0 Тогда
			Решение.Текст = СтрШаблон(НСтр("ru = 'Токен не подходит для раздела «%1»: при создании токена отметьте категорию «%1»'"), Раздел);
		Иначе
			Решение.Текст = СтрШаблон(НСтр("ru = 'WB запретил доступ (%1): проверьте, что в кабинете включена работа по модели FBS'"),
				ТекстОшибкиWB(Ответ));
		КонецЕсли;
	ИначеЕсли Код = 402 Тогда
		Решение.Действие = "Остановить";
		Решение.Текст = СтрШаблон(НСтр("ru = 'WB требует оплату доступа к API: %1'"), ТекстОшибкиWB(Ответ));
	ИначеЕсли Код = 404 Тогда
		Решение.Действие = "Остановить";
		Решение.Текст = СтрШаблон(НСтр("ru = 'WB не нашёл %1 (%2). Для остатков проверьте ID склада WB в настройках'"), Элемент.Путь, ТекстОшибкиWB(Ответ));
	ИначеЕсли Код <> 409 Тогда
		Решение.Действие = "Остановить";
		Решение.Текст = СтрШаблон(НСтр("ru = 'WB отклонил %1 %2: код %3, %4'"), Элемент.Метод, Элемент.Путь, Код, ТекстОшибкиWB(Ответ));
	КонецЕсли;

	Если Код = 409 И Элемент.Обработчик <> "Отправка" Тогда
		Решение.Действие = "Остановить";
		Решение.Текст = СтрШаблон(НСтр("ru = 'WB ответил 409 на %1: %2'"), Элемент.Путь, ТекстОшибкиWB(Ответ));
	КонецЕсли;
	Возврат Решение;

КонецФункции

Функция ВсеОшибкиСКодом(Данные, Код)

	Если ТипЗнч(Данные) <> Тип("Массив") Или Данные.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Ошибка Из Данные Цикл
		Если Поле(Ошибка, "code", "") <> Код Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ТекстОшибкиWB(Ответ)

	Данные = Ответ.Данные;
	Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Если Данные.Получить("detail") <> Неопределено Тогда
			Возврат Данные.Получить("detail");
		КонецЕсли;
		Если Данные.Получить("code") <> Неопределено Тогда
			Возврат СокрЛП(Поле(Данные, "code", "") + " " + Поле(Данные, "message", ""));
		КонецЕсли;
	ИначеЕсли ТипЗнч(Данные) = Тип("Массив") И Данные.Количество() > 0 Тогда
		Возврат СокрЛП(Поле(Данные[0], "code", "") + " " + Поле(Данные[0], "message", ""));
	КонецЕсли;
	Возврат Лев(СокрЛП(Ответ.Текст), 300);

КонецФункции

Функция ПаузаПовтора(Попыток)

	Пауза = 1000;
	Для Счетчик = 1 По Попыток Цикл
		Пауза = Пауза * 2;
	КонецЦикла;
	Возврат Мин(Пауза, 30000);

